<div class="modal" id="qvm" role="dialog" aria-modal="true" aria-label="{{ 'grs.a11y.quick_view' | t }}" hidden=""><div class="mbox"><div class="mimg" id="qimg"></div><div class="mtxt"><span class="qv-name" id="qname"></span><div class="pprow"><span class="pprice" id="qprice"></span><span class="pcad" id="qcur">CAD</span><span class="instock">{{ 'grs.product.in_stock' | t }}</span></div><p class="lead" id="qdesc"></p><div class="opt" id="qfinw"><span class="olab">{{ 'grs.product.finish' | t }} <b id="qfinname">{{ 'grs.product.brushed' | t }}</b></span><div class="sws" id="qfin"></div></div><div class="opt qv-opt" id="qoptw" hidden=""></div>{%- render 'grs-dims', mode: 'qv' -%}<div class="opt" id="qbuy"><span class="olab">{{ 'grs.product.quantity' | t }}</span><div class="qtyrow"><div class="qty"><button type="button" id="qqm" aria-label="{{ 'grs.a11y.decrease_qty' | t }}">−</button><span id="qqn">1</span><button type="button" id="qqp" aria-label="{{ 'grs.a11y.increase_qty' | t }}">+</button></div><button type="button" class="btn dark cart-btn" id="qadd"><span class="dot"></span><span>{{ 'grs.product.add_to_cart' | t }}</span></button></div></div><a class="btn dark cart-btn" id="qopts" href="{{ routes.root_url }}" hidden=""><span class="dot"></span><span>{{ 'grs.product.choose_options' | t }}</span></a><a class="qv-more" id="qlink" href="{{ routes.root_url }}">{{ 'grs.product.view_details' | t }} <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true"><path d="M1 5h12M9 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div><button type="button" class="x" id="qx" aria-label="{{ 'grs.a11y.close' | t }}"><svg width="18" height="17" viewBox="0 0 18 17" fill="none"><path d="M1.2 0.8l15.6 15.4M16.8 0.8L1.2 16.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg></button></div></div>
