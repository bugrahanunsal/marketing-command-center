{%- comment -%}
  Responsive <img> for a photo picked in the theme editor (image: section.settings.image) or a file in Settings > Files (name: 'file.webp').
  render 'grs-img', image: section.settings.image, class: 'ph', sizes: '100vw', widths: '600,900,1200', eager: true, attrs: ' id="x"'
  The alt text is the photo's own (Settings > Files) unless alt: is given. Prints nothing when there is no photo.
{%- endcomment -%}
{%- liquid
  if image
    assign im = image
  else
    assign im = images[name]
  endif
-%}
{%- if im != blank -%}
  {%- assign ws = widths | default: '400,600,800,1000,1200,1600' | split: ',' -%}
  {%- assign wmax = ws | last | plus: 0 -%}
  <img width="{{ im.width }}" height="{{ im.height }}" class="{{ class | default: 'ph' }}" src="{{ im | image_url: width: wmax }}" srcset="{% for w in ws %}{% assign wn = w | plus: 0 %}{{ im | image_url: width: wn }} {{ wn }}w{% unless forloop.last %}, {% endunless %}{% endfor %}" sizes="{{ sizes | default: '100vw' }}" alt="{% if alt %}{{ alt }}{% else %}{{ im.alt | escape }}{% endif %}"{% if eager %} loading="eager" fetchpriority="high"{% else %} loading="lazy" fetchpriority="low"{% endif %} decoding="async"{{ attrs }}>
{%- endif -%}
