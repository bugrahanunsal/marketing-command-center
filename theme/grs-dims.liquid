{%- liquid
  assign rows = grs_dim_rows | strip | newline_to_br | split: '<br />'
  assign lg = request.locale.iso_code | slice: 0, 2
  case lg
    when 'es'
      assign l_dim = 'Dimensiones'
      assign l_ang = 'Ángulo'
    else
      assign l_dim = 'Dimensions'
      assign l_ang = 'Angle'
  endcase
  assign js = ''
  assign d0 = ''
  assign a0 = ''
  assign found = false
  if mode == 'pdp'
    for vv in product.variants
      assign k = vv.id | append: ''
      for row in rows
        assign c = row | strip | split: '|'
        if c[0] == k
          assign found = true
          assign jd = c[1] | json
          assign ja = c[2] | json
          assign js = js | append: ',' | append: c[0] | append: ':[' | append: jd | append: ',' | append: ja | append: ']'
          if vv.id == variant.id
            assign d0 = c[1]
            assign a0 = c[2]
          endif
          break
        endif
      endfor
    endfor
  else
    for row in rows
      assign c = row | strip | split: '|'
      assign jd = c[1] | json
      assign ja = c[2] | json
      assign js = js | append: ',' | append: c[0] | append: ':[' | append: jd | append: ',' | append: ja | append: ']'
    endfor
  endif
  assign js = js | remove_first: ','
-%}
{%- capture ic_dim -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"></path><path d="m14.5 12.5 2-2"></path><path d="m11.5 9.5 2-2"></path><path d="m8.5 6.5 2-2"></path><path d="m17.5 15.5 2-2"></path></svg>{%- endcapture -%}
{%- capture ic_ang -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 20.5h17"></path><path d="M3.5 20.5 14 5"></path><path d="M10.5 20.5a7 7 0 0 0-3-5.75"></path></svg>{%- endcapture -%}
{%- if mode == 'pdp' -%}
  {%- if found -%}
<div class="pdim" id="pdim"{% if d0 == blank %} hidden{% endif %}><div class="pdim-i"><span class="pdim-ic">{{ ic_dim }}</span><span class="pdim-t"><em>{{ l_dim }}</em><b data-k="0">{{ d0 | escape }}</b></span></div><div class="pdim-i"{% if a0 == blank %} hidden{% endif %}><span class="pdim-ic">{{ ic_ang }}</span><span class="pdim-t"><em>{{ l_ang }}</em><b data-k="1">{{ a0 | escape }}</b></span></div></div>
<script>(function(){var M={ {{- js -}} },b=document.getElementById("pdim");if(!b||b._g)return;b._g=1;function s(r){b.hidden=!r;if(!r)return;[0,1].forEach(function(k){var e=b.querySelector('[data-k="'+k+'"]'),v=r[k]||"";if(!e)return;e.parentNode.parentNode.hidden=!v;if(e.textContent!==v){e.textContent=v;e.classList.remove("in");void e.offsetWidth;e.classList.add("in")}})}(b.closest("form")||document).addEventListener("change",function(e){var t=e.target;t&&t.name==="id"&&s(M[t.value])})})();</script>
  {%- endif -%}
{%- else -%}
<div class="pdim pdim-qv" id="qdim" hidden><div class="pdim-i"><span class="pdim-ic">{{ ic_dim }}</span><span class="pdim-t"><em>{{ l_dim }}</em><b data-k="0"></b></span></div><div class="pdim-i"><span class="pdim-ic">{{ ic_ang }}</span><span class="pdim-t"><em>{{ l_ang }}</em><b data-k="1"></b></span></div></div>
<script>(function(){var M={ {{- js -}} },b=document.getElementById("qdim");if(!b||b._g)return;b._g=1;document.addEventListener("grs:qv",function(e){var d=e.detail||{},r=M[String(d.v)];b.hidden=!r;if(!r)return;[0,1].forEach(function(k){var x=b.querySelector('[data-k="'+k+'"]'),v=r[k]||"";if(!x)return;x.parentNode.parentNode.hidden=!v;if(x.textContent!==v){x.textContent=v;x.classList.remove("in");void x.offsetWidth;x.classList.add("in")}})})})();</script>
{%- endif -%}
