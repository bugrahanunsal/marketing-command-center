{%- comment -%}
  "Dimensions" box under the Size buttons. It shows the size text of the variant on screen and changes with the
  Size choice (Big / Small ...). The texts are edited in the theme editor: Header > Product sizes
  (sections/grs-sizes.liquid prints them as JSON, #grs-sizes, before the page content).
    render 'grs-dims', mode: 'pdp'   -> product page, inside the product form, under the options
    render 'grs-dims', mode: 'qv'    -> quick view (assets/grs.js sends "grs:qv" with the variant ID)
  A variant with no size text shows no box.
{%- endcomment -%}
{%- capture ic_dim -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"></path><path d="m14.5 12.5 2-2"></path><path d="m11.5 9.5 2-2"></path><path d="m8.5 6.5 2-2"></path><path d="m17.5 15.5 2-2"></path></svg>{%- endcapture -%}
{%- if mode == 'pdp' -%}
<div class="pdim" id="pdim" hidden><span class="pdim-ic">{{ ic_dim }}</span><span class="pdim-t"><em></em><b></b></span></div>
<script>(function(){var b=document.getElementById("pdim");if(!b||b._g)return;b._g=1;var m=b.querySelector("em"),e=b.querySelector("b"),f=b.closest("form")||document,n=f.querySelector('input[name="id"]'),J=null;function L(){try{J=JSON.parse(document.getElementById("grs-sizes").textContent)}catch(x){J=null}}function S(id,a){var v=J&&J.v&&J.v[id]||"";b.hidden=!v;if(!v)return;m.textContent=J.label||"";if(e.textContent!==v){e.textContent=v;if(a){e.classList.remove("in");void e.offsetWidth;e.classList.add("in")}}}L();S(n&&n.value,0);f.addEventListener("change",function(t){t=t.target;t&&t.name==="id"&&S(t.value,1)});document.addEventListener("shopify:section:load",function(){L();S(n&&n.value,0)})})();</script>
{%- else -%}
<div class="pdim pdim-qv" id="qdim" hidden><span class="pdim-ic">{{ ic_dim }}</span><span class="pdim-t"><em></em><b></b></span></div>
<script>(function(){var b=document.getElementById("qdim");if(!b||b._g)return;b._g=1;var m=b.querySelector("em"),e=b.querySelector("b");document.addEventListener("grs:qv",function(t){var J=null;try{J=JSON.parse(document.getElementById("grs-sizes").textContent)}catch(x){}var d=t.detail||{},v=J&&J.v&&J.v[String(d.v)]||"";b.hidden=!v;if(!v)return;m.textContent=J.label||"";if(e.textContent!==v){e.textContent=v;e.classList.remove("in");void e.offsetWidth;e.classList.add("in")}})})();</script>
{%- endif -%}
