{%- liquid
  assign rows = grs_dim_rows | strip | newline_to_br | split: '<br />'
  assign lg = request.locale.iso_code | slice: 0, 2
  if lg == 'es'
    assign l_dim = 'Dimensiones'
  else
    assign l_dim = 'Dimensions'
  endif
  assign js = ''
  assign d0 = ''
  assign found = false
  if mode == 'pdp'
    for vv in product.variants
      assign k = vv.id | append: ''
      for row in rows
        assign c = row | strip | split: '|'
        if c[0] == k
          assign found = true
          assign jd = c[1] | json
          assign js = js | append: ',' | append: c[0] | append: ':' | append: jd
          if vv.id == variant.id
            assign d0 = c[1]
          endif
          break
        endif
      endfor
    endfor
  else
    for row in rows
      assign c = row | strip | split: '|'
      assign jd = c[1] | json
      assign js = js | append: ',' | append: c[0] | append: ':' | append: jd
    endfor
  endif
  assign js = js | remove_first: ','
-%}
{%- capture ic_dim -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"></path><path d="m14.5 12.5 2-2"></path><path d="m11.5 9.5 2-2"></path><path d="m8.5 6.5 2-2"></path><path d="m17.5 15.5 2-2"></path></svg>{%- endcapture -%}
{%- if mode == 'pdp' -%}
  {%- if found -%}
<div class="pdim" id="pdim"{% if d0 == blank %} hidden{% endif %}><span class="pdim-ic">{{ ic_dim }}</span><span class="pdim-t"><em>{{ l_dim }}</em><b>{{ d0 | escape }}</b></span></div>
<script>(function(){var M={ {{- js -}} },b=document.getElementById("pdim");if(!b||b._g)return;b._g=1;var e=b.querySelector("b");(b.closest("form")||document).addEventListener("change",function(t){t=t.target;if(!t||t.name!=="id")return;var v=M[t.value]||"";b.hidden=!v;if(v&&e.textContent!==v){e.textContent=v;e.classList.remove("in");void e.offsetWidth;e.classList.add("in")}})})();</script>
  {%- endif -%}
{%- else -%}
<div class="pdim pdim-qv" id="qdim" hidden><span class="pdim-ic">{{ ic_dim }}</span><span class="pdim-t"><em>{{ l_dim }}</em><b></b></span></div>
<script>(function(){var M={ {{- js -}} },b=document.getElementById("qdim");if(!b||b._g)return;b._g=1;var e=b.querySelector("b");document.addEventListener("grs:qv",function(t){var d=t.detail||{},v=M[String(d.v)]||"";b.hidden=!v;if(v&&e.textContent!==v){e.textContent=v;e.classList.remove("in");void e.offsetWidth;e.classList.add("in")}})})();</script>
{%- endif -%}
