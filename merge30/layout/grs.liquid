        {%- if request.page_type == 'policy' -%}
          {%- liquid
            assign pol_html = content_for_layout
            assign pol_title = page_title
            if pol_html contains '<div class="shopify-policy__title">'
              assign t_in = pol_html | split: '<div class="shopify-policy__title">' | last | split: '</div>' | first
              assign pol_title = t_in | strip_html | strip | default: page_title
              assign t_block = '<div class="shopify-policy__title">' | append: t_in | append: '</div>'
              assign pol_html = pol_html | remove_first: t_block
            endif
          -%}
          {% render 'grs-policy', html: pol_html, title: pol_title %}
        {%- elsif template.name == 'index' and request.design_mode == false -%}
          {%- comment -%}
            Home: the photos further down (img.ph, img.ph.studio ... with loading="lazy") get their files only after the page has loaded
            and painted, or at the first scroll or tap (script below the page). Otherwise the ones within a screen or
            two of the first screen (about 450 KB) download together with the first screen and hold back its photo on
            phones. A 1-pixel placeholder stands in until then; the photos fill fixed boxes, so nothing moves. The
            shop-the-look slides then load at once (their slider moves the other slides out of reach of lazy loading).
          {%- endcomment -%}
          {%- liquid
            assign lz = content_for_layout | split: '<img class="ph'
            echo lz.first
            for lzp in lz
              if forloop.first
                continue
              endif
              assign lzt = lzp | split: '>' | first
              assign lzr = lzp | remove_first: lzt
              if lzt contains 'loading="lazy"'
                assign lzt = ' ' | append: lzt | replace: ' src="', ' src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-gl-src="' | replace: ' srcset="', ' data-gl-srcset="' | remove_first: ' '
              endif
              echo '<img class="ph' | append: lzt | append: lzr
            endfor
          -%}
        {%- else -%}
          {{ content_for_layout }}
        {%- endif %}
      </main>
