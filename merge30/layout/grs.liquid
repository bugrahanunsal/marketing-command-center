<!doctype html>
{%- comment -%} The same file is layout/theme.liquid: store policy pages (no template) show in the new design (snippets/grs-policy). {%- endcomment -%}
{%- liquid
  assign grs_us = false
  if localization.market.handle == 'us' or localization.country.iso_code == 'US'
    assign grs_us = true
  endif
  case template.name
    when 'index'
      assign grs_view = 'home'
    when 'article'
      assign grs_view = 'post'
    when 'list-collections', 'cart', 'customers'
      assign grs_view = 'page'
    else
      assign grs_view = template.name
  endcase
  assign grs_asset = ''
  case template.name
    when 'product'
      assign grs_asset = 'grs-product'
    when 'collection'
      assign grs_asset = 'grs-collection'
    when 'page', 'article', 'blog', 'search', 'cart', 'list-collections', '404'
      assign grs_asset = 'grs-page'
  endcase
  assign grs_t = template.name | handle
  if request.page_type == 'policy'
    assign grs_view = 'page'
    assign grs_asset = 'grs-page'
    assign grs_t = 'policy'
  endif
-%}
<html class="js{% if grs_us %} mk-us{% endif %}" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- comment -%} The first-screen photo (a <picture data-lcp>, e.g. the home hero) starts loading with the first bytes of
      the page instead of after the head: its phone and computer sources, each for its own screen width {%- endcomment -%}
    {%- liquid
      assign lcp_parts = content_for_layout | split: '<picture data-lcp>'
      if lcp_parts.size > 1
        assign lcp_tags = lcp_parts[1] | split: '</picture>' | first | split: '<'
        assign lcp_not = ''
        for lcp_t in lcp_tags
          unless lcp_t contains 'srcset="'
            continue
          endunless
          assign lcp_set = lcp_t | split: 'srcset="' | last | split: '"' | first
          assign lcp_sizes = lcp_t | split: ' sizes="' | last | split: '"' | first
          if lcp_t contains 'media="'
            assign lcp_media = lcp_t | split: 'media="' | last | split: '"' | first
            echo '<link rel="preload" as="image" imagesrcset="' | append: lcp_set | append: '" imagesizes="' | append: lcp_sizes | append: '" media="' | append: lcp_media | append: '" fetchpriority="high">'
            assign lcp_not = 'not all and ' | append: lcp_media
          else
            echo '<link rel="preload" as="image" imagesrcset="' | append: lcp_set | append: '" imagesizes="' | append: lcp_sizes | append: '"'
            if lcp_not != ''
              echo ' media="' | append: lcp_not | append: '"'
            endif
            echo ' fetchpriority="high">'
          endif
        endfor
      endif
    -%}
    <meta name="google-site-verification" content="78J9yIJ_jekuLxxpBM1QR_kDyM3mxd0Zq5mAgUpdWMM" />
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %}{% assign grs_tags = current_tags | join: ', ' %} &ndash; {{ 'grs.general.tagged' | t: tags: grs_tags }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: number: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {%- comment -%} Order: the dark-mode switch, then the font settings the speed snippet's overlay is drawn with (so the
      overlay has its final line metrics from its first paint: nothing moves when the fonts arrive), then the speed snippet
      (the owner's, unchanged), then our first-screen styles, the full style files and the font faces, as in the live
      theme where the snippet comes before the theme's styles. {%- endcomment -%}
    {%- comment -%} Dark mode before first paint: the visitor's saved choice (dark mode switch) {%- endcomment -%}
    <script>try{if(localStorage.getItem('grs-theme')==='dark')document.documentElement.classList.add('grs-dark');}catch(e){}</script>
    {%- comment -%} Later (grsLater): tracking tags and the apps' after-load scripts wait for the visitor's first scroll, tap,
      key or mouse move, so they do not compete with the first screen {%- endcomment -%}
    <script>(function(w){var q=[],r=0,E=["pointerdown","keydown","touchstart","wheel","mousemove","scroll"];function go(){if(r)return;r=1;E.forEach(function(e){w.removeEventListener(e,go,{passive:!0})});for(var f;f=q.shift();)try{f()}catch(x){}}w.grsLater=function(f){r?setTimeout(f,0):q.push(f)};E.forEach(function(e){w.addEventListener(e,go,{passive:!0})})})(window)</script>
    {%- comment -%} Shop cart sync (Sign in with Shop, in content_for_header) starts right after the page's first paint
      instead of possibly before it: the hidden Shop Pay frame it adds held back the whole page's first paint until
      that frame loaded (seen on PageSpeed's phones, by 0.7 to 1.8 s). Without a paint (a page opened in the
      background) it starts after 4 s. {%- endcomment -%}
    <script>(function(w){w.grsShopSync=function(c){var f=function(){if(!f)return;f=null;var s=w.Shopify&&w.Shopify.SignInWithShop;s&&s.initShopCartSync&&s.initShopCartSync(c)},o;setTimeout(function(){f&&f()},4e3);try{o=new PerformanceObserver(function(){o.disconnect();setTimeout(function(){f&&f()},0)});o.observe({type:"paint",buffered:!0})}catch(e){f()}}})(window)</script>
    {%- comment -%} Shopify's customer-events loader (the Google, Facebook, Lucky Orange, ... pixels in Settings > Customer
      events) is added to the page by Shopify after the theme, so its main file (/cdn/wpm/...js) is held back here until
      grsLater, unless Theme settings > GRS tracking > Load tracking pixels right away is on. Any other script is added as
      usual; if Shopify changes how the file is added, it loads as before. {%- endcomment -%}
    {%- unless request.design_mode or settings.grs_pixels_now -%}
    <script>(function(N){var a=N.appendChild;N.appendChild=function(c){if(c&&c.tagName==="SCRIPT"&&/\/cdn\/wpm\/[^\/]+\.js/.test(c.src||"")){var p=this;N.appendChild=a;grsLater(function(){a.call(p,c)});return c}return a.call(this,c)};grsLater(function(){N.appendChild=a})})(Node.prototype)</script>
    {%- endunless -%}
    {%- comment -%} Font settings for the speed snippet's overlay (snippets/grs-fonts, part 'early') {%- endcomment -%}
    {%- render 'grs-fonts', part: 'early' -%}
    {%- if template.suffix == 'nospeed' -%}
      {%- comment -%} PageSpeed comparison only: the same home without the live speed script {%- endcomment -%}
      {% render 'grs-meta-tags' %}
    {%- else -%}
      {% render 'meta-tags' %}
    {%- endif -%}

    {%- comment -%}
      First paint: the first-screen styles are in the page (snippets/grs-critical-*, generated from the style files by
      pg/critical.py), and the full style files load at the same time without holding the page back. Parts that are
      hidden on the first screen (menus, drawers, windows) stay hidden until the full styles are in (class grs-css).
    {%- endcomment -%}
    {%- case grs_asset -%}
      {%- when 'grs-product' -%}{%- render 'grs-critical-product' -%}
      {%- when 'grs-collection' -%}{%- render 'grs-critical-collection' -%}
      {%- when 'grs-page' -%}{%- render 'grs-critical-page' -%}
      {%- else -%}{%- render 'grs-critical-home' -%}
    {%- endcase -%}
    <script>(function(d){d.grsCss={% if grs_asset != '' %}2{% else %}1{% endif %};window.grsCssIn=function(l){l.onload=l.onerror=null;l.rel='stylesheet';if(--d.grsCss<=0)d.classList.add('grs-css')}})(document.documentElement)</script>
    <link rel="preload" as="style" href="{{ 'grs.css' | asset_url }}" onload="grsCssIn(this)" onerror="grsCssIn(this)">
    {%- if grs_asset != '' -%}<link rel="preload" as="style" href="{{ grs_asset | append: '.css' | asset_url }}" onload="grsCssIn(this)" onerror="grsCssIn(this)">{%- endif %}
    <noscript>{{ 'grs.css' | asset_url | stylesheet_tag }}{%- if grs_asset != '' -%}{{ grs_asset | append: '.css' | asset_url | stylesheet_tag }}{%- endif -%}</noscript>
    {%- comment -%} Fonts from Shopify's font library on the store's own address (Theme settings > GRS fonts) {%- endcomment -%}
    {%- render 'grs-fonts' -%}
    {%- comment -%} Readability: grey secondary text and the blue card badges at a contrast of 4.5:1 or more {%- endcomment -%}
    <style>:root:not(.grs-dark){--fg2:#6B6B67}.card .badge.soft{background:#356AEF}</style>
    {%- comment -%} Country / language menus (snippets/grs-loc-rows): country and language in each row; in the footer and the
      phone menu the language goes on a second line, and the lists stay inside the screen on phones {%- endcomment -%}
    <style>.loc-list li span.loc-t,.loc-list li span.loc-l{gap:0;width:auto;min-width:0;padding:0;border-radius:0;font:inherit;color:inherit;text-align:left}.loc-list li span.loc-t{display:block;white-space:normal}.loc-list li span.loc-l{display:inline;white-space:nowrap}.loc-list li span.loc-l:before{content:"· "}.loc-list li span.loc-t:after,.loc-list li span.loc-l:after{content:none}.dr-mk .loc-list li span.loc-l,.ft2 .loc-list li span.loc-l{display:block;font-size:12.5px;font-weight:500;line-height:1.35;color:var(--fg2)}.dr-mk .loc-list li span.loc-l:before,.ft2 .loc-list li span.loc-l:before{content:none}.dr-top .dr-mk .loc-list{max-width:calc(min(440px,90vw) - 32px)}.ft2-locs .loc-dd{max-width:100%}</style>
    {%- comment -%} Section heights ("Height" sliders, snippets/grs-vars): the computer value from 1100 px wide, the phone and
      tablet value below, so a computer height does not change phones {%- endcomment -%}
    <style>[data-grs]{--grs-ih:var(--grs-ih-d,1)}@media(max-width:1099px){[data-grs]{--grs-ih:var(--grs-ih-m,1)}}</style>
    {%- comment -%} Menus (Resources, Guides): moving from one menu to another swaps the panels at once instead of fading both and
      replaying the list animation (class nd-sw, set by grs.js), and a row lights up only when the mouse stays on it, so rows the
      mouse only passes over do not blink {%- endcomment -%}
    <style>.nd-sw .ndp{transition:none!important}.nd-dd .ndp-li{transition:background-color .1s ease}.nd-dd .ndp-ic{transition:background-color .1s ease,color .1s ease}.nd-dd .ndp-li>.ndp-arr{transition:opacity .1s ease,transform .1s ease}.nd-dd .ndp-li:hover{transition:background-color .2s ease .06s}.nd-dd .ndp-li:hover .ndp-ic{transition:background-color .25s ease .06s,color .25s ease .06s}.nd-dd .ndp-li:hover>.ndp-arr{transition:opacity .25s ease .06s,transform .3s cubic-bezier(.22,1,.36,1) .06s}</style>
    {%- comment -%} Hardware studio photos (img.studio): the photo's grey studio backdrop is evened out to white in the browser
      (each pixel divided by the backdrop colour measured at the photo's left and right edges), so with the existing
      mix-blend-mode: multiply the product sits straight on the card colour, as in the prototype. Card photos stay hidden
      until this is done (a fraction of a second); if it cannot be done the original photo is shown. {%- endcomment -%}
    <style>.ff-on .card-media img.ph.studio:not(.ffd){opacity:0}.card-media img.ph.studio{transition:opacity .2s ease,transform var(--long) ease}</style>
    <script>(function(){var W=window,D=document;D.documentElement.classList.add("ff-on");function ff(im){if(!im.complete||!im.naturalWidth)return;var u=im.currentSrc||im.src;if(!u||u.indexOf("blob:")===0||u.indexOf("data:")===0||im._ff===u)return;im._ff=u;im.classList.remove("ffd");try{var w=im.naturalWidth,h=im.naturalHeight,s=Math.min(1,900/Math.max(w,h));w=Math.round(w*s);h=Math.round(h*s);var c=D.createElement("canvas");c.width=w;c.height=h;var x=c.getContext("2d",{willReadFrequently:true});x.drawImage(im,0,0,w,h);var d=x.getImageData(0,0,w,h),p=d.data,k=Math.max(2,Math.round(w/40)),y,i,j,ch,L=[0,0,0],R=[0,0,0],v,t,b;for(y=0;y<h;y++){for(ch=0;ch<3;ch++){var a=[],r=[];for(i=0;i<k;i++){a.push(p[(y*w+i)*4+ch]);r.push(p[(y*w+w-1-i)*4+ch])}a.sort(function(m,n){return m-n});r.sort(function(m,n){return m-n});L[ch]=a[k>>1];R[ch]=r[k>>1]}for(i=0;i<w;i++){t=i/(w-1);j=(y*w+i)*4;for(ch=0;ch<3;ch++){b=L[ch]*(1-t)+R[ch]*t;if(b<120)b=120;v=p[j+ch]*255/b;p[j+ch]=v>255?255:v}}}x.putImageData(d,0,0);c.toBlob(function(bl){if(!bl){im.classList.add("ffd");return}var n=URL.createObjectURL(bl);im.srcset="";im.src=n;im.classList.add("ffd")},"image/webp",.92)}catch(e){im.classList.add("ffd")}}D.addEventListener("error",function(e){var t=e.target;if(t.tagName==="IMG"&&(t.classList.contains("studio")||t.closest(".ndp-im.st")))t.classList.add("ffd")},true);D.addEventListener("load",function(e){var t=e.target;if(t.tagName==="IMG"&&(t.classList.contains("studio")||t.closest(".ndp-im.st")))ff(t)},true);function all(){D.querySelectorAll("img.studio,.ndp-im.st img").forEach(function(im){if(im.complete)ff(im)})}if(D.readyState!=="loading")all();else D.addEventListener("DOMContentLoaded",all);W.grsFF=ff})();</script>
    {%- comment -%} Product photo boxes (cards, product gallery and its thumbnails, quick view, small product thumbnails): a stronger
      grey (#E4E3DF, the theme's first stage colour) so the boxes stand out from the page colour; light theme only {%- endcomment -%}
    <style>:root:not(.grs-dark) :is(.card-media,.gal-main,.gal-thumbs,.mimg,.qv-slide,.plist-th,.ndp-im){--stage:#E4E3DF}</style>
    {%- comment -%} Instagram section box: the same grey, so the box stands out from the white section around it {%- endcomment -%}
    <style>:root:not(.grs-dark) .ig{background:#E4E3DF!important}</style><style>@media(min-width:990px){.cmp3-sec{--cmp-pad:clamp(28px,2.6vw,44px);padding-top:calc(var(--cmp-pad)*var(--grs-pt,1));padding-bottom:calc(var(--cmp-pad)*var(--grs-pb,1))}.cmp3{row-gap:16px;align-items:center}.cmp3-head .mh2{margin:10px 0 8px;font-size:calc(clamp(28px,2.5vw,42px)*var(--grs-hs,1))}.cmp3-p{font-size:calc(clamp(15px,1vw,16px)*var(--grs-ts,1));line-height:1.5}.cmp3-opts{gap:8px}.cmp3-o{padding:10px 16px}.cmp3-o .sw{width:28px;height:28px}.cmp3-ot b{font-size:calc(15px*var(--grs-cs,1))}.cmp3-ot em{font-size:calc(13px*var(--grs-ts,1))}.cmp3-pr{font-size:17px}.cmp3-same{margin-top:14px;gap:6px}.cmp3-same li{font-size:calc(14px*var(--grs-ts,1))}.cmp3-cta{margin-top:16px}.cmp3-media .cmp{height:max(360px,min(calc(clamp(360px,33vw,540px)*var(--grs-ih,1)),calc(100vh - var(--hdh,155px) - 2*var(--cmp-pad))));height:max(360px,min(calc(clamp(360px,33vw,540px)*var(--grs-ih,1)),calc(100svh - var(--hdh,155px) - 2*var(--cmp-pad))))}.cmp-hint{margin-top:8px}.cmp3-media{justify-self:end;width:86%}}</style><style>.ndp-im{aspect-ratio:4/2.85}.ndp-im.st img{object-fit:contain;padding:4% 5%;mix-blend-mode:multiply}</style><style>.drawer .dr-top{padding-left:20px;padding-right:20px}.drawer #drawerx{margin-left:-8px}.drawer .dr-top .dr-logo img{transform:translateY(18%)}</style><style>.np .np-bg{-webkit-backdrop-filter:none;backdrop-filter:none;background:#080c12a6}</style><style>.grs-dark .dr-loc .theme-sw[aria-checked=true] .ts-track{background:#ffdf5e}</style><style>.grs-dark .hd2,.grs-dark .drawer .dr-top{--bg:#EBEBE9;--bg2:#F7F7F7;--card:#FFFFFF;--stage:#E4E3DF;--fg:#2B2B2B;--fg2:#6B6B67;--line:#DADAD6;color-scheme:light;color:var(--fg)}.grs-dark .hd2{box-shadow:0 1px 0 #353533}.grs-dark .drawer .dr-top{background:var(--card);border-bottom:1px solid var(--line)}.grs-dark .hd2-nav{--bg:#141414;--bg2:#1B1B1B;--card:#222221;--stage:#2A2A29;--fg:#EDEDEB;--fg2:#A3A39E;--line:#353533;color-scheme:dark