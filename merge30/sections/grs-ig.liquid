{%- liquid
  if routes.root_url == '/'
    assign r = ''
  else
    assign r = routes.root_url
  endif
  assign grs_us = false
  if localization.market.handle == 'us' or localization.country.iso_code == 'US'
    assign grs_us = true
  endif
-%}
<section class="sec igsec"{% render 'grs-vars', s: section.settings %}><div class="wrap"><div class="ig"><div class="ig-top"><div class="ig-l">{%- if section.settings.eyebrow != blank -%}<span class="dot-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}<h2 class="mh2"><a href="{{ section.settings.profile_url | escape }}" rel="noopener" target="_blank">{{ section.settings.heading }}</a></h2></div><div class="ig-r">{%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}<div class="ig-who"><a class="ig-av" href="{{ section.settings.profile_url | escape }}" target="_blank" rel="noopener"><i><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><path d="M17.5 6.5h.01"></path></svg></i><span><b>{{ section.settings.handle }}</b><em>Instagram</em></span></a>{%- if section.settings.button_label != blank -%}<a class="btn" href="{{ section.settings.profile_url | escape }}" target="_blank" rel="noopener"><span class="dot"></span>{{ section.settings.button_label }}</a>{%- endif -%}</div></div></div>
{%- liquid
  assign ig_app = false
  for block in section.blocks
    if block.type == '@app'
      assign ig_app = true
    endif
  endfor
-%}<div class="ig-slide{% if ig_app %} ig-app{% endif %}">{%- if ig_app -%}{%- comment -%} Instafeed app block: the app loads the latest posts into .ig-feed; the script below copies the posts into the
  section's own moving strip (4:5 tiles, each post shown whole, no cropping) and then hides the app's own layout. If the
  posts cannot be read (the app changes, or loads nothing), the app's own feed simply stays visible. {%- endcomment -%}<style>.ig-app:not(.is-built) .ig-row,.ig-app:not(.is-built) .ig-nav{display:none!important}.ig-app.is-built .ig-feed{display:none!important}.ig-app .ig-track a{background:#1d1d1b}.ig-app .ig-track a img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:contain;display:block}</style>{%- unless request.design_mode -%}<script>window.instafeedStorefrontScheduled=!0</script>{%- endunless -%}{%- for block in section.blocks -%}{%- if block.type == '@app' -%}<div class="ig-feed" {{ block.shopify_attributes }}>{% render block %}</div>{%- endif -%}{%- endfor -%}<div class="ig-row"><div class="ig-track"></div></div><div class="ig-nav"><button type="button" data-d="-1" aria-label="{{ 'grs.a11y.prev_posts' | t }}"><svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M7 1L1 7l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button type="button" data-d="1" aria-label="{{ 'grs.a11y.next_posts' | t }}"><svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div><script>(function(){var s=document.currentScript,box=s.parentNode,ig=box.closest(".ig"),feed=box.querySelector(".ig-feed"),row=box.querySelector(".ig-row"),tr=box.querySelector(".ig-track"),prof={{ section.settings.profile_url | json }},lab={{ 'grs.a11y.ig_post' | t: n: '#' | json }};if(!ig||!feed||!row||!tr)return;ig._init=1;var built=0,t0=Date.now(),tm=0,mo;function lo(){t0=Date.now();later();var u=window.instafeedScriptSrc,b,sc=document.getElementsByTagName("script"),i,n;if(!u)return;b=String(u).split("?")[0];for(i=0;i<sc.length;i++)if(String(sc[i].src).split("?")[0]===b)return;n=document.createElement("script");n.async=!0;n.src=u;document.body.appendChild(n)}if("IntersectionObserver"in window){var io=new IntersectionObserver(function(e){if(e[0].isIntersecting){io.disconnect();lo()}},{rootMargin:"800px 0px"});io.observe(ig)}else lo();function urlOf(e){if(e.tagName==="VIDEO")return e.poster||"";if(e.tagName==="IMG"){var l=[e.currentSrc,e.getAttribute("src"),e.getAttribute("data-src"),e.getAttribute("data-lazy"),e.getAttribute("data-original")],j;for(j=0;j<l.length;j++)if(l[j]&&l[j].indexOf("data:")!==0)return l[j];return""}var b=e.style.backgroundImage||"",m=b.match(/url\(["']?([^"')]+)/);return m?m[1]:""}function links(e){var a=e.closest("a[href]");return a&&/instagram\.com\/(p|reel|tv)\//.test(a.href)?a.href:prof}function scan(){if(built)return;var els=feed.querySelectorAll('img,video,[style*="background-image"]'),seen={},c=[],i,u;for(i=0;i<els.length;i++){u=urlOf(els[i]);if(!u||u.indexOf("data:")===0||/\.svg(\?|#|$)/i.test(u)||seen[u])continue;seen[u]=1;c.push({u:u,h:links(els[i])})}if(c.length<3)return;var left=c.length,ok=[];c.forEach(function(p,k){var im=new Image();im.onload=im.onerror=function(){var w=im.naturalWidth,h=im.naturalHeight;if(w>=150&&h>=150&&w/h>.45&&w/h<1.6)ok[k]=p;if(--left===0)build(ok.filter(Boolean))};im.src=p.u})}function build(ps){if(built||ps.length<3)return;built=1;if(mo)mo.disconnect();var html="";for(var pass=0;pass<2;pass++)ps.forEach(function(p,k){html+='<a href="'+p.h.replace(/"/g,"&quot;")+'" target="_blank" rel="noopener"'+(pass?' tabindex="-1" aria-hidden="true"':' aria-label="'+lab.replace("#",k+1).replace(/"/g,"&quot;")+'"')+'><img src="'+p.u.replace(/"/g,"&quot;")+'" alt="" loading="lazy" decoding="async" draggable="false"></a>'});tr.innerHTML=html;box.classList.add("is-built");move()}function later(){clearTimeout(tm);if(!built&&Date.now()-t0<20000)tm=setTimeout(scan,400)}mo=new MutationObserver(later);mo.observe(feed,{childList:true,subtree:true,attributes:true,attributeFilter:["src","style","poster"]});document.addEventListener("instafeedAppLoaded",later);later();function move(){var a=0,hov=!1,dr=!1,sx=0,sa=0,mv=0,v=0,tg=null,last=0,vis=!0,rm=window.matchMedia("(prefers-reduced-motion: reduce)").matches;function W(){return tr.scrollWidth/2}function put(){var L=W();if(L){while(a<=-L){a+=L;if(tg!==null)tg+=L}while(a>0){a-=L;if(tg!==null)tg-=L}}tr.style.transform="translate3d("+a+"px,0,0)"}if("IntersectionObserver"in window)new IntersectionObserver(function(e){vis=e[0].isIntersecting}).observe(row);function tick(t){if(!row.isConnected)return;var d=last?Math.min(t-last,50):16;last=t;if(!dr&&vis){if(tg!==null){a+=(tg-a)*.14;if(Math.abs(tg-a)<.5){a=tg;tg=null}}else if(Math.abs(v)>.02){a+=v*d;v*=.93}else if(!hov&&!rm)a-=.035*d;put()}requestAnimationFrame(tick)}requestAnimationFrame(tick);row.addEventListener("mouseenter",function(){hov=!0});row.addEventListener("mouseleave",function(){hov=!1});row.addEventListener("pointerdown",function(e){dr=!0;mv=0;sx=e.clientX;sa=a;v=0;tg=null;row.classList.add("drag")});window.addEventListener("pointermove",function(e){if(!dr)return;var x=e.clientX-sx;mv=Math.max(mv,Math.abs(x));var n=sa+x;v=(n-a)/16;a=n;put()});window.addEventListener("pointerup",function(){if(dr){dr=!1;row.classList.remove("drag")}});row.addEventListener("click",function(e){e.preventDefault();e.stopPropagation();if(mv>6)return;var t=e.target.closest("a[href]");window.open(t&&t.href?t.href:prof,"_blank","noopener")},true);row.addEventListener("wheel",function(e){if(Math.abs(e.deltaX)>Math.abs(e.deltaY)){e.preventDefault();a-=e.deltaX;v=0;tg=null;put()}},{passive:false});box.querySelectorAll(".ig-nav button").forEach(function(b){b.addEventListener("click",function(){var f=tr.querySelector("a"),w=f?f.offsetWidth+14:280;v=0;tg=(tg!==null?tg:a)-(+b.dataset.d)*w});b.addEventListener("mouseenter",function(){hov=!0});b.addEventListener("mouseleave",function(){hov=!1})})}})();</script>{%- else -%}<div class="ig-row"><div class="ig-track">{%- for pass in (1..2) -%}{%- for block in section.blocks -%}{%- if block.settings.image -%}<a href="{{ section.settings.profile_url | escape }}" target="_blank" rel="noopener" aria-label="{{ 'grs.a11y.ig_post' | t: n: forloop.index }}"{% if pass == 2 %} tabindex="-1" aria-hidden="true"{% endif %}{% if pass == 1 %} {{ block.shopify_attributes }}{% endif %}>{% render 'grs-img', image: block.settings.image, class: 'ph', sizes: '(max-width:749px) 45vw, 300px', widths: '300,450,600' %}</a>{%- endif -%}{%- endfor -%}{%- endfor -%}</div></div><div class="ig-nav"><button type="button" data-d="-1" aria-label="{{ 'grs.a11y.prev_posts' | t }}"><svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M7 1L1 7l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button type="button" data-d="1" aria-label="{{ 'grs.a11y.next_posts' | t }}"><svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div>{%- endif -%}</div></div></div></section>

