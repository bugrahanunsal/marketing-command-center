{%- comment -%}
  Latest blog posts on a page (prototype .pg-blog): small title, heading, "View all" and the posts as cards. Layout on
  computer and on phone: grid or slider (Layout and sizes).
  Texts left empty in the theme editor show the standard texts of locales/*.json (grs.sd.pg_blog), in the
  visitor's language.
{%- endcomment -%}
{%- liquid
  assign sd_eyebrow = 'grs.sd.pg_blog.eyebrow_html' | t
  assign sd_eyebrow = section.settings.eyebrow | default: sd_eyebrow
  assign sd_heading = 'grs.sd.pg_blog.heading_html' | t
  assign sd_heading = section.settings.heading | default: sd_heading
  assign sd_button_label = 'grs.sd.pg_blog.button_label_html' | t
  assign sd_button_label = section.settings.button_label | default: sd_button_label
-%}
{%- liquid
  assign b = section.settings.blog
  if b == blank
    assign b = blogs.news
  endif
-%}
<section class="sec pg-blog"{% render 'grs-vars', s: section.settings %}><div class="wrap"><div class="sh2"><div>{%- if sd_eyebrow != blank -%}<span class="dot-eyebrow">{{ sd_eyebrow | escape }}</span>{%- endif -%}<h2 class="mh2">{{ sd_heading }}</h2></div>{%- if sd_button_label != blank -%}<a class="btn btn-o" href="{{ b.url }}"><span class="dot"></span>{{ sd_button_label | escape }}</a>{%- endif -%}</div><div class="bsl" id="bsl-{{ section.id }}"><div class="bgrid2{% if section.settings.layout_desktop == 'slider' %} bsl-d{% endif %}{% unless section.settings.layout_mobile == 'stack' %} bsl-m{% endunless %}">{%- for a in b.articles limit: section.settings.posts -%}{% render 'grs-post-card', a: a %}{%- endfor -%}</div>{%- if section.settings.layout_desktop == 'slider' -%}<button class="ps-btn prev" type="button" aria-label="{{ 'grs.a11y.prev_posts' | t }}" disabled><svg width="8" height="14" viewBox="0 0 8 14" fill="none" aria-hidden="true"><path d="M7 1L1 7l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button class="ps-btn next" type="button" aria-label="{{ 'grs.a11y.next_posts' | t }}"><svg width="8" height="14" viewBox="0 0 8 14" fill="none" aria-hidden="true"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>{%- endif -%}</div></div></section>
{%- if section.settings.layout_desktop == 'slider' or section.settings.layout_mobile != 'stack' -%}<style>.bsl{position:relative}.bgrid2.bsl-d::-webkit-scrollbar,.bgrid2.bsl-m::-webkit-scrollbar{display:none}@media(min-width:750px){.bgrid2.bsl-d{display:flex;gap:clamp(20px,2.4vw,36px);overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;overscroll-behavior-x:contain}.bgrid2.bsl-d>.bc2{flex:0 0 calc((100% - (var(--grs-cols,3) - 1)*clamp(20px,2.4vw,36px))/(var(--grs-cols,3) + .15));scroll-snap-align:start} }@media(min-width:750px) and (max-width:989px){.bgrid2.bsl-d>.bc2{flex-basis:calc((100% - clamp(20px,2.4vw,36px))/2.15)} }@media(max-width:749px){.bgrid2.bsl-m{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;overscroll-behavior-x:contain;margin-inline:calc(var(--g)*-1);padding-inline:var(--g);scroll-padding-inline:var(--g)}.bgrid2.bsl-m>.bc2{flex:0 0 min(82%,420px);scroll-snap-align:start} }</style>{%- endif -%}
<script>(function(){function i(){var s=document.getElementById('bsl-{{ section.id }}');if(!s||s._i)return;var t=s.querySelector('.bgrid2'),a=s.querySelector('.ps-btn.prev'),b=s.querySelector('.ps-btn.next');if(!t||!a||!b)return;s._i=1;function w(){var c=t.querySelector('.bc2');return c?c.getBoundingClientRect().width+(parseFloat(getComputedStyle(t).columnGap)||0):t.clientWidth}function u(){a.disabled=t.scrollLeft<4;b.disabled=t.scrollLeft+t.clientWidth>=t.scrollWidth-4;var m=t.querySelector('.bc2-img');if(m&&m.offsetHeight)s.style.setProperty('--ps-mid',m.offsetHeight/2+'px')}a.addEventListener('click',function(){t.scrollBy({left:-w(),behavior:'smooth'})});b.addEventListener('click',function(){t.scrollBy({left:w(),behavior:'smooth'})});t.addEventListener('scroll',u,{passive:true});window.addEventListener('resize',u);u()}i();document.addEventListener('shopify:section:load',i)})();</script>

{% schema %}
{"name":"GRS blog posts (page)","tag":"div","settings":[{"type":"text","id":"eyebrow","label":"Small title","placeholder":"Blog","info":"Empty: the standard text, in the visitor's language."},{"type":"inline_richtext","id":"heading","label":"Heading","info":"Empty: the standard text, in the visitor's language."},{"type":"blog","id":"blog","label":"Blog","info":"Empty: News."},{"type":"text","id":"button_label","label":"Button","placeholder":"View all","info":"Empty: the standard text, in the visitor's language."},{"type":"header","content":"Layout and sizes","info":"100% keeps the original design."},{"type":"range","id":"content_width","label":"Content width","min":800,"max":1800,"step":20,"default":1440,"unit":"px"},{"type":"range","id":"space_top","label":"Space above","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"range","id":"space_bottom","label":"Space below","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"range","id":"columns","label":"Posts per row","min":2,"max":4,"step":1,"default":3,"info":"Phones and tablets keep their own layout."},{"type":"range","id":"posts","label":"Number of posts","min":1,"max":24,"step":1,"default":12},{"type":"select","id":"layout_desktop","label":"Layout on computer","default":"grid","options":[{"value":"grid","label":"Grid (rows)"},{"value":"slider","label":"Slider (side by side)"}]},{"type":"select","id":"layout_mobile","label":"Layout on phone","default":"slider","options":[{"value":"slider","label":"Slider (side by side, swipe)"},{"value":"stack","label":"Stacked (one under another)"}],"info":"With a slider, raise \"Number of posts\" so there is more to swipe through."},{"type":"header","content":"Text sizes and style","info":"Sizes are set separately for computers and phones. 100% keeps the original design."},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"eyebrow_size","label":"Small title size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"eyebrow_size_mobile","label":"Small title size (phone)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size","label":"Heading size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size_mobile","label":"Heading size (phone)"},{"type":"select","id":"heading_weight","label":"Heading weight","default":"default","options":[{"value":"default","label":"As designed"},{"value":"300","label":"Light"},{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}]},{"type":"select","id":"heading_case","label":"Heading letters","default":"default","options":[{"value":"default","label":"As written"},{"value":"uppercase","label":"ALL CAPITALS"}]},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"title_size","label":"Post title size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"title_size_mobile","label":"Post title size (phone)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size","label":"Text size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size_mobile","label":"Text size (phone)"}],"presets":[{"name":"GRS blog posts (page)"}]}
{% endschema %}