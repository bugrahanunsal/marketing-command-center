{%- comment -%}
  The page title and the page's own text (Online Store > Pages), with a side column: "On this page" (the text's
  H2 headings, from 3 headings up; a heading without an id gets one made from its words) and a help card
  (prototype S.main). The text keeps its links in the
  visitor's language (grs-rte); questions written in the text open and close (data-fq, assets/grs-page.js).
  Texts left empty in the theme editor show the standard texts of locales/*.json (grs.sd.pg_main), in the
  visitor's language.
{%- endcomment -%}
{%- liquid
  assign sd_toc_label = 'grs.sd.pg_main.toc_label_html' | t
  assign sd_toc_label = section.settings.toc_label | default: sd_toc_label
  assign sd_help_title = 'grs.sd.pg_main.help_title_html' | t
  assign sd_help_title = section.settings.help_title | default: sd_help_title
  assign sd_help_text = 'grs.sd.pg_main.help_text_html' | t
  assign sd_help_text = section.settings.help_text | default: sd_help_text
  assign sd_button_label = 'grs.sd.pg_main.button_label_html' | t
  assign sd_button_label = section.settings.button_label | default: sd_button_label
  assign sd_codes_eyebrow = 'grs.sd.pg_main.codes_eyebrow_html' | t
  assign sd_codes_eyebrow = section.settings.codes_eyebrow | default: sd_codes_eyebrow
  assign sd_codes_heading_us = 'grs.sd.pg_main.codes_heading_us_html' | t
  assign sd_codes_heading_us = section.settings.codes_heading_us | default: sd_codes_heading_us
  assign sd_codes_heading_ca = 'grs.sd.pg_main.codes_heading_ca_html' | t
  assign sd_codes_heading_ca = section.settings.codes_heading_ca | default: sd_codes_heading_ca
-%}
{%- liquid
  assign grs_phone = settings.grs_phone | default: '(855) 452-7715'
  assign grs_phone_tel = grs_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' | prepend: '+1'
  assign src = page.content | append: ''
  assign toc_ids = ''
  assign toc_tx = ''
  assign n = 0
  assign parts = src | split: '<h2'
  assign body = parts.first | default: ''
  for part in parts
    if forloop.first
      continue
    endif
    assign head = part | split: '</h2>' | first
    assign attrs = head | split: '>' | first
    assign htx = head | remove_first: attrs | remove_first: '>' | strip_html | replace: '&nbsp;', ' ' | strip
    assign hid = ''
    if attrs contains 'id="'
      assign hid = attrs | split: 'id="' | last | split: '"' | first | strip
      assign body = body | append: '<h2' | append: part
    elsif htx != ''
      assign hid = htx | handleize
      assign body = body | append: '<h2 id="' | append: hid | append: '"' | append: part
    else
      assign body = body | append: '<h2' | append: part
    endif
    assign hd = htx | downcase
    assign s1 = hd | slice: 0, 17
    assign s2 = hd | slice: 0, 8
    assign s3 = hd | slice: 0, 15
    if s1 == 'table of contents' or s2 == 'contents' or s3 == 'in this article'
      assign htx = ''
    endif
    if hid != '' and htx != ''
      assign toc_ids = toc_ids | append: hid | append: '␟'
      assign toc_tx = toc_tx | append: htx | append: '␟'
      assign n = n | plus: 1
    endif
  endfor
  assign body = body | replace: '<table', '<div class="tbl"><table' | replace: '</table>', '</table></div>'
  comment
    The page title is the page's H1: a heading 1 in the text becomes a heading 2.
  endcomment
  assign body = body | replace: '<h1', '<h2' | replace: '</h1>', '</h2>'
  comment
    Pictures in the page text load when the visitor comes near them, not all together with the page (most are far
    below the first screen). The first one still loads with the page (it can be on the first screen, on some pages it
    is the largest thing there). A picture whose tag already says how to load is left as it is.
  endcomment
  if body contains '<img'
    assign ip = body | split: '<img'
    assign body = ip.first | default: ''
    for part in ip
      if forloop.first
        continue
      endif
      assign itag = part | split: '>' | first
      if forloop.index == 2 or itag contains 'loading='
        assign body = body | append: '<img' | append: part
      else
        assign body = body | append: '<img loading="lazy"' | append: part
      endif
    endfor
  endif
  comment
    Globo forms pasted into the page text (<div class="globo-formbuilder" data-id="...">) are drawn by this section's
    Globo form blocks, one per form, its Shortcode being that same tag: the block of a form that is in the text takes
    its place there (a marker until the text is done), the other blocks are not output. So the Globo app embed, which
    put the code of the forms on every page of the store, stays off. A block whose output has no settings for its form
    (a form Globo no longer has: empty on the live theme too) is left out, and only one block is used on a page: a
    second copy of the block's code stops with an error (it declares the same names again), and its form stays empty.
  endcomment
  assign gfb_out = ''
  if body contains 'class="globo-formbuilder"'
    assign gfb_n = 0
    for block in section.blocks
      if gfb_n > 0
        break
      endif
      capture gfb
        render block
      endcapture
      assign gfb_id = gfb | split: 'class="globo-formbuilder" data-id="'
      if gfb_id.size < 2
        continue
      endif
      assign gfb_id = gfb_id[1] | split: '"' | first
      assign gfb_tag = '<div class="globo-formbuilder" data-id="' | append: gfb_id | append: '"></div>'
      assign gfb_num = gfb_id | base64_decode
      assign gfb_set = 'FormBuilder.forms[' | append: gfb_num | append: ']'
      if body contains gfb_tag and gfb contains gfb_set
        assign gfb_n = gfb_n | plus: 1
        assign gfb_mark = '[[grs-globo-' | append: gfb_n | append: ']]'
        assign body = body | replace_first: gfb_tag, gfb_mark
        assign gfb_out = gfb_out | append: gfb | append: '␞'
      endif
    endfor
  endif
  assign ids = toc_ids | split: '␟'
  assign txs = toc_tx | split: '␟'
  assign hub = false
  assign hub_hs = section.settings.hub_pages | split: ','
  for x in hub_hs
    assign xh = x | strip
    if xh != '' and xh == page.handle
      assign hub = true
    endif
  endfor
  assign show_toc = false
  if section.settings.show_toc and n >= 3
    assign show_toc = true
  endif
-%}
{%- capture toc_li -%}{%- for hid in ids -%}<li><a href="#{{ hid | escape }}" data-anchor="{{ hid | escape }}">{{ txs[forloop.index0] | escape }}</a></li>{%- endfor -%}{%- endcapture -%}
{%- capture loc -%}{% render 'grs-pg-loc' %}{%- endcapture -%}{%- assign L = loc | split: '␟' -%}
{%- capture rte -%}{% render 'grs-rte', html: body %}{%- endcapture -%}
{%- if gfb_out != '' -%}{%- assign gfbs = gfb_out | split: '␞' -%}{%- for g in gfbs -%}{%- assign gfb_mark = '[[grs-globo-' | append: forloop.index | append: ']]' -%}{%- assign rte = rte | replace: gfb_mark, g -%}{%- endfor -%}{%- endif -%}
<div class="pg-main-w"{% render 'grs-vars', s: section.settings %}><section class="pg-top"><div class="wrap">{%- if section.settings.show_crumb -%}{% render 'grs-pg-crumb', cur: page.title %}{%- endif -%}<h1 class="pg-title">{{ page.title | escape }}</h1></div></section>{%- unless hub -%}<section class="pg-body"><div class="wrap pg-grid"><div class="pg-main">{%- if L[0] == 'codehub' and section.settings.show_codes -%}{%- if L[1] == 'CA' -%}{%- assign ch = sd_codes_heading_ca -%}{%- else -%}{%- assign ch = sd_codes_heading_us -%}{%- endif -%}{% render 'grs-pg-codelist', L: L, heading: ch, eyebrow: sd_codes_eyebrow, mode: 'hub', ncol: section.settings.codes_cols, ncol_m: section.settings.codes_cols_m %}{%- endif -%}{%- if show_toc -%}<details class="pg-toc-m"><summary>{{ sd_toc_label | escape }}</summary><ol>{{ toc_li }}</ol></details>{%- endif -%}<div class="rte"{% unless section.settings.faq_open_close %} data-fq="0"{% endunless %}>{{ rte }}</div></div><aside class="pg-aside">{%- if show_toc -%}<nav class="ip-card pg-toc" aria-label="{{ sd_toc_label | escape }}"><span class="mono">{{ sd_toc_label | escape }}</span><ol>{{ toc_li }}</ol></nav>{%- endif -%}{%- if sd_help_title != blank -%}<div class="ip-card ip-help"><b>{{ sd_help_title | escape }}</b>{%- if sd_help_text != blank -%}<p>{{ sd_help_text | escape }}</p>{%- endif -%}<a class="ip-phone" href="tel:{{ grs_phone_tel }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"></path><path d="M21 16v2a4 4 0 0 1-4 4h-5"></path></svg>{{ grs_phone }}</a>{%- if sd_button_label != blank -%}<a class="btn" href="{%- if section.settings.button_link != blank -%}{% render 'grs-url', url: section.settings.button_link %}{%- else -%}{{ pages['contact'].url | default: '/pages/contact' }}{%- endif -%}"><span class="dot"></span>{{ sd_button_label | escape }}</a>{%- endif -%}</div>{%- endif -%}</aside></div></section>{%- endunless -%}</div>
{%- if section.settings.faq_schema and hub == false -%}{%- capture fq -%}{% render 'grs-rte-faq', html: body %}{%- endcapture -%}{%- assign fq = fq | strip -%}{%- if fq != '' -%}<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ fq }}]}</script>{%- endif -%}{%- endif -%}

{% schema %}
{"name":"GRS page text","tag":"div","class":"grs-pg-main-sec","settings":[{"type":"paragraph","content":"The title and the text come from the page itself (Online Store > Pages). On the American and Canadian building code pages the list of their states or provinces shows under the title."},{"type":"checkbox","id":"show_crumb","label":"Show the breadcrumb","default":true},{"type":"text","id":"hub_pages","label":"Pages that show the FAQ instead of their text","default":"faq","info":"Page handles separated by commas. These pages show their title and the \"GRS FAQ page\" section, not their page text."},{"type":"checkbox","id":"show_toc","label":"Show \"On this page\"","default":true,"info":"Made from the H2 headings of the text that have an id; shown from 3 headings up."},{"type":"text","id":"toc_label","label":"\"On this page\" title","placeholder":"On this page","info":"Empty: the standard text, in the visitor's language."},{"type":"checkbox","id":"faq_open_close","label":"Questions in the text open and close","default":true},{"type":"checkbox","id":"faq_schema","label":"Give Google the questions of the text (FAQ data)","default":true},{"type":"header","content":"Help card"},{"type":"text","id":"help_title","label":"Title","info":"Empty: no help card.","placeholder":"Questions about your project?"},{"type":"textarea","id":"help_text","label":"Text","placeholder":"Call or text a railing specialist, or send your measurements for a detailed quote.","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"button_label","label":"Button","placeholder":"Get a free quote","info":"Empty: the standard text, in the visitor's language."},{"type":"url","id":"button_link","label":"Button link","info":"Empty: the contact page."},{"type":"header","content":"National building code pages"},{"type":"checkbox","id":"show_codes","label":"List the states or provinces under the title","default":true},{"type":"text","id":"codes_eyebrow","label":"Small title","placeholder":"Building codes","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"codes_heading_us","label":"Heading (American code page)","placeholder":"Select your state","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"codes_heading_ca","label":"Heading (Canadian code page)","placeholder":"Select your province or territory","info":"Empty: the standard text, in the visitor's language."},{"type":"range","id":"codes_cols","label":"Columns on computers","min":2,"max":6,"step":1,"default":4},{"type":"range","id":"codes_cols_m","label":"Columns on phones","min":1,"max":3,"step":1,"default":2},{"type":"header","content":"Layout and sizes","info":"100% keeps the original design."},{"type":"header","content":"Text sizes and style","info":"Sizes are set separately for computers and phones. 100% keeps the original design."},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size","label":"Heading size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size_mobile","label":"Heading size (phone)"},{"type":"select","id":"heading_weight","label":"Heading weight","default":"default","options":[{"value":"default","label":"As designed"},{"value":"300","label":"Light"},{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}]},{"type":"select","id":"heading_case","label":"Heading letters","default":"default","options":[{"value":"default","label":"As written"},{"value":"uppercase","label":"ALL CAPITALS"}]}],"blocks":[{"type":"@app"}],"presets":[{"name":"GRS page text"}]}
{% endschema %}