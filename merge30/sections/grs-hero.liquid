{%- liquid
  if routes.root_url == '/'
    assign r = ''
  else
    assign r = routes.root_url
  endif
  assign grs_us = false
  if localization.market.handle == 'us' or localization.country.iso_code == 'US'
    assign grs_us = true
  endif
-%}
{%- liquid
  assign rv_n = shop.metafields.judgeme.all_reviews_count.value | default: shop.metafields.judgeme.all_reviews_count | default: 3004
  assign rv_avg = shop.metafields.judgeme.all_reviews_rating.value | default: shop.metafields.judgeme.all_reviews_rating | default: 4.94
-%}
{%- liquid
  assign hero_h = section.settings.heading
  assign hero_s = section.settings.text
  assign hero_plain = hero_h | strip_html | strip
  assign hero_long = false
  if hero_plain.size > 40
    assign hero_long = true
  endif
-%}
{%- comment -%} Phones and tablets: the hero is at least 400 px tall (was 560 px) and the space above the buttons shrinks on
  short screens, so the buttons stay on the first screen; taller screens look the same. "Height (phone and tablet)" still
  scales it, and "Height (computer)" only changes computers. {%- endcomment -%}
<style>@media(max-width:1099px){.hero-photo .hero-txt{min-height:calc(clamp(400px,calc(100svh - 148px),800px)*var(--grs-ih,1))}.hero-photo .hero-btns{padding-top:clamp(24px,calc(100svh - 520px),150px)}}</style>
<section class="hero hero-photo{% if hero_long %} hero-long{% endif %}"{% render 'grs-vars', s: section.settings %}><picture data-lcp>{%- assign im_m = section.settings.image_mobile -%}{%- if im_m != blank -%}<source media="(max-width:1099px)" srcset="{{ im_m | image_url: width: 600 }} 600w, {{ im_m | image_url: width: 900 }} 900w, {{ im_m | image_url: width: 1200 }} 1200w" sizes="100vw">{%- endif -%}{% render 'grs-img', image: section.settings.image, class: 'ph', sizes: '100vw', widths: '1100,1500,1900,2400', eager: true %}</picture>
<div class="hero-txt"><div class="hero-copy"><p class="hero-proof"><span class="rv-stars" aria-hidden="true">{% render 'grs-stars' %}</span>{%- capture grs_n -%}{% render 'grs-num', n: rv_n %}{%- endcapture -%}{{ 'grs.reviews.from_count' | t: count: grs_n }}</p><h1 class="disp" id="hh1"><strong>{{ hero_h }}</strong></h1><p class="lead" id="hsub">{{ hero_s }}</p></div><div class="hero-btns">{%- if section.settings.button_label != blank -%}<a class="btn lg" href="{% render 'grs-url', url: section.settings.button_link %}"><span class="dot"></span>{{ section.settings.button_label }}</a>{%- endif -%}{%- if section.settings.button2_label != blank -%}<a class="btn btn-o lg" href="{% render 'grs-url', url: section.settings.button2_link %}"><span class="dot"></span>{{ section.settings.button2_label }}</a>{%- endif -%}</div></div>
</section>

{% schema %}
{"name":"GRS hero","tag":"div","settings":[{"type":"html","id":"heading","label":"Heading","info":"Words inside <span class=\"hl\">...</span> get the yellow highlight."},{"type":"html","id":"text","label":"Text"},{"type":"header","content":"Photo"},{"type":"image_picker","id":"image","label":"Photo (computer)"},{"type":"image_picker","id":"image_mobile","label":"Photo (phone and tablet)"},{"type":"header","content":"Buttons"},{"type":"text","id":"button_label","label":"First button label"},{"type":"url","id":"button_link","label":"First button link"},{"type":"text","id":"button2_label","label":"Second button label"},{"type":"url","id":"button2_link","label":"Second button link"},{"type":"header","content":"Layout and sizes","info":"100% keeps the original design."},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"image_height","label":"Height (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"image_height_mobile","label":"Height (phone and tablet)"},{"type":"header","content":"Text sizes and style","info":"Sizes are set separately for computers and phones. 100% keeps the original design."},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"eyebrow_size","label":"Reviews line size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"eyebrow_size_mobile","label":"Reviews line size (phone)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size","label":"Heading size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size_mobile","label":"Heading size (phone)"},{"type":"select","id":"heading_weight","label":"Heading weight","default":"default","options":[{"value":"default","label":"As designed"},{"value":"300","label":"Light"},{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}]},{"type":"select","id":"heading_case","label":"Heading letters","default":"default","options":[{"value":"default","label":"As written"},{"value":"uppercase","label":"ALL CAPITALS"}]},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size","label":"Text size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size_mobile","label":"Text size (phone)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_width","label":"Text width"}],"presets":[{"name":"GRS hero"}]}
{% endschema %}
