{%- comment -%}
  Quote request (prototype .pg-formsec): texts and contact details on the left, the form on the right.
  The form is Shopify's contact form: messages go to the store's email (Settings > Notifications > Staff), with the
  page they were sent from. An app form block added to this section (Globo Form Builder, Shopify Forms, Hulk ...)
  takes the form's place. "Balcony" shows two extra lists (balcony type, preferred system).
  [currency] in a point is the visitor's currency (CAD or USD).
  Layout "Contact page" (prototype contact page): breadcrumb, small title, the page title (H1), the page text and the
  phone and email cards on the left, the form on the right. Layout "Form only": the form (or the app's form) alone in
  a centered card, for forms that are not quote requests (sign-up, consent ...).
  Texts left empty in the theme editor show the standard texts of locales/*.json (grs.sd.pg_form), in the
  visitor's language.
{%- endcomment -%}
{%- liquid
  assign sd_contact_eyebrow = 'grs.sd.pg_form.contact_eyebrow_html' | t
  assign sd_contact_eyebrow = section.settings.contact_eyebrow | default: sd_contact_eyebrow
  assign sd_eyebrow = 'grs.sd.pg_form.eyebrow_html' | t
  assign sd_eyebrow = section.settings.eyebrow | default: sd_eyebrow
  assign sd_heading = 'grs.sd.pg_form.heading_html' | t
  assign sd_heading = section.settings.heading | default: sd_heading
  assign sd_text = 'grs.sd.pg_form.text_html' | t
  assign sd_text = section.settings.text | default: sd_text
  assign sd_point1 = 'grs.sd.pg_form.point1_html' | t
  assign sd_point1 = section.settings.point1 | default: sd_point1
  assign sd_point2 = 'grs.sd.pg_form.point2_html' | t
  assign sd_point2 = section.settings.point2 | default: sd_point2
  assign sd_point3 = 'grs.sd.pg_form.point3_html' | t
  assign sd_point3 = section.settings.point3 | default: sd_point3
  assign sd_phone_label = 'grs.sd.pg_form.phone_label_html' | t
  assign sd_phone_label = section.settings.phone_label | default: sd_phone_label
  assign sd_email_label = 'grs.sd.pg_form.email_label_html' | t
  assign sd_email_label = section.settings.email_label | default: sd_email_label
  assign sd_hours_label = 'grs.sd.pg_form.hours_label_html' | t
  assign sd_hours_label = section.settings.hours_label | default: sd_hours_label
  assign sd_hours = 'grs.sd.pg_form.hours_html' | t
  assign sd_hours = section.settings.hours | default: sd_hours
  assign sd_name_label = 'grs.sd.pg_form.name_label_html' | t
  assign sd_name_label = section.settings.name_label | default: sd_name_label
  assign sd_email_field = 'grs.sd.pg_form.email_field_html' | t
  assign sd_email_field = section.settings.email_field | default: sd_email_field
  assign sd_phone_field = 'grs.sd.pg_form.phone_field_html' | t
  assign sd_phone_field = section.settings.phone_field | default: sd_phone_field
  assign sd_optional = 'grs.sd.pg_form.optional_html' | t
  assign sd_optional = section.settings.optional | default: sd_optional
  assign sd_zip_label_ca = 'grs.sd.pg_form.zip_label_ca_html' | t
  assign sd_zip_label_ca = section.settings.zip_label_ca | default: sd_zip_label_ca
  assign sd_zip_label_us = 'grs.sd.pg_form.zip_label_us_html' | t
  assign sd_zip_label_us = section.settings.zip_label_us | default: sd_zip_label_us
  assign sd_types_label = 'grs.sd.pg_form.types_label_html' | t
  assign sd_types_label = section.settings.types_label | default: sd_types_label
  assign sd_types = 'grs.sd.pg_form.types_html' | t
  assign sd_types = section.settings.types | default: sd_types
  assign sd_systems_label = 'grs.sd.pg_form.systems_label_html' | t
  assign sd_systems_label = section.settings.systems_label | default: sd_systems_label
  assign sd_systems = 'grs.sd.pg_form.systems_html' | t
  assign sd_systems = section.settings.systems | default: sd_systems
  assign sd_details_label = 'grs.sd.pg_form.details_label_html' | t
  assign sd_details_label = section.settings.details_label | default: sd_details_label
  assign sd_details_placeholder = 'grs.sd.pg_form.details_placeholder_html' | t
  assign sd_details_placeholder = section.settings.details_placeholder | default: sd_details_placeholder
  assign sd_button_label = 'grs.sd.pg_form.button_label_html' | t
  assign sd_button_label = section.settings.button_label | default: sd_button_label
  assign sd_note = 'grs.sd.pg_form.note_html' | t
  assign sd_note = section.settings.note | default: sd_note
  assign sd_error_text = 'grs.sd.pg_form.error_text_html' | t
  assign sd_error_text = section.settings.error_text | default: sd_error_text
  assign sd_ok_title = 'grs.sd.pg_form.ok_title_html' | t
  assign sd_ok_title = section.settings.ok_title | default: sd_ok_title
  assign sd_ok_text = 'grs.sd.pg_form.ok_text_html' | t
  assign sd_ok_text = section.settings.ok_text | default: sd_ok_text
-%}
{%- liquid
  assign grs_us = false
  if localization.market.handle == 'us' or localization.country.iso_code == 'US'
    assign grs_us = true
  endif
  assign cur = localization.country.currency.iso_code | default: cart.currency.iso_code | default: 'CAD'
  assign cur_html = '<span class="cur">' | append: cur | append: '</span>'
  assign fid = 'pf-' | append: section.id
  assign phone = settings.grs_phone | default: '(855) 452-7715'
  assign tel = phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.'
  assign email = settings.grs_email | default: 'info@glassrailingstore.com'
  if grs_us
    assign zip = sd_zip_label_us
  else
    assign zip = sd_zip_label_ca
  endif
  assign from = page.title | default: request.path
-%}
{%- capture form_html -%}
{%- if section.blocks.size > 0 -%}<div class="pg-form-app">{%- for block in section.blocks -%}{% render block %}{%- endfor -%}</div>
{%- else -%}
{%- form 'contact', id: fid, class: 'qform pg-qform' -%}
{%- if form.posted_successfully? -%}<div class="fok" role="status"><b>{{ sd_ok_title }}</b><span>{{ sd_ok_text }}</span></div>{%- endif -%}
<input type="hidden" name="contact[Page]" value="{{ from | escape }} ({{ request.path | escape }})">
<div class="f2"><div class="fld"><label for="{{ fid }}n">{{ sd_name_label }}</label><input class="inp" id="{{ fid }}n" type="text" name="contact[name]" autocomplete="name" data-req="name" required></div><div class="fld"><label for="{{ fid }}e">{{ sd_email_field }}</label><input class="inp" id="{{ fid }}e" type="email" name="contact[email]" autocomplete="email" data-req="email" required></div></div>
<div class="f2"><div class="fld"><label for="{{ fid }}p">{{ sd_phone_field }} <em>{{ sd_optional }}</em></label><input class="inp" id="{{ fid }}p" type="tel" name="contact[phone]" autocomplete="tel"></div><div class="fld"><label for="{{ fid }}z">{{ zip }} <em>{{ sd_optional }}</em></label><input class="inp" id="{{ fid }}z" type="text" name="contact[{{ zip | escape }}]" autocomplete="postal-code"></div></div>
{%- if section.settings.variant == 'balcony' -%}{%- assign t_opts = sd_types | newline_to_br | split: '<br />' -%}{%- assign s_opts = sd_systems | newline_to_br | split: '<br />' -%}
<div class="f2"><div class="fld"><label for="{{ fid }}t">{{ sd_types_label }}</label><div class="pg-sel"><select class="sel" id="{{ fid }}t" name="contact[{{ sd_types_label | escape }}]">{%- for o in t_opts -%}{%- assign o = o | strip -%}{%- if o != '' -%}<option>{{ o | escape }}</option>{%- endif -%}{%- endfor -%}</select><svg width="12" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true"><path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div><div class="fld"><label for="{{ fid }}s">{{ sd_systems_label }}</label><div class="pg-sel"><select class="sel" id="{{ fid }}s" name="contact[{{ sd_systems_label | escape }}]">{%- for o in s_opts -%}{%- assign o = o | strip -%}{%- if o != '' -%}<option>{{ o | escape }}</option>{%- endif -%}{%- endfor -%}</select><svg width="12" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true"><path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div></div>
{%- endif -%}
<div class="fld"><label for="{{ fid }}m">{{ sd_details_label }}</label><textarea class="inp" id="{{ fid }}m" name="contact[body]" rows="4" placeholder="{{ sd_details_placeholder | escape }}"></textarea></div>
<p class="ferr"{% if form.errors == blank %} hidden{% endif %} role="alert">{%- if form.errors != blank -%}{{ form.errors | default_errors }}{%- else -%}{{ sd_error_text }}{%- endif -%}</p>
<div class="qsub"><button class="btn" type="submit"><span class="dot"></span>{{ sd_button_label }}</button>{%- if sd_note != blank -%}<span>{{ sd_note }}</span>{%- endif -%}</div>
{%- endform -%}
{%- endif -%}
{%- endcapture -%}
{%- if section.settings.layout == 'contact' -%}
<section class="pg-contact" id="quote-form"{% render 'grs-vars', s: section.settings %}><div class="wrap"><div class="qgrid"><div class="qintro">{%- if section.settings.show_crumb -%}{% render 'grs-pg-crumb', cur: page.title %}{%- endif -%}{%- if sd_contact_eyebrow != blank -%}<span class="dot-eyebrow">{{ sd_contact_eyebrow }}</span>{%- endif -%}<h1 class="h1">{{ page.title | escape }}</h1>{%- if page.content != blank -%}<div class="rte">{% render 'grs-rte', html: page.content %}</div>{%- endif -%}
<div class="ccards"><a class="ccard" href="tel:+1{{ tel | remove: '+1' }}"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"></path><path d="M21 16v2a4 4 0 0 1-4 4h-5"></path></svg><span><em>{{ sd_phone_label }}</em><b>{{ phone }}</b></span><svg width="8" height="14" viewBox="0 0 8 14" fill="none" aria-hidden="true"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a><a class="ccard" href="mailto:{{ email }}"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg><span><em>{{ sd_email_label }}</em><b>{{ email }}</b></span><svg width="8" height="14" viewBox="0 0 8 14" fill="none" aria-hidden="true"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div>
<div class="pg-contact-f"><div class="sec pg-formsec"><div class="wrap"><div class="pg-form">{{ form_html }}</div></div></div></div></div></div></section>
{%- elsif section.settings.layout == 'solo' -%}
<section class="sec pg-formsec pg-form-solo" id="form-{{ section.id }}"{% render 'grs-vars', s: section.settings %}><div class="wrap"><div class="pg-form">{{ form_html }}</div></div></section>
{%- else -%}
<section class="sec pg-formsec" id="quote-form"{% render 'grs-vars', s: section.settings %}><div class="wrap"><div class="pg-form"><div class="pg-form-l">
{%- if sd_eyebrow != blank -%}<span class="dot-eyebrow">{{ sd_eyebrow }}</span>{%- endif -%}
{%- if sd_heading != blank -%}<h2 class="mh2">{{ sd_heading }}</h2>{%- endif -%}
{%- if sd_text != blank -%}<p>{{ sd_text }}</p>{%- endif -%}
{%- if sd_point1 != blank or sd_point2 != blank or sd_point3 != blank -%}<ul class="pg-form-pts">
{%- for i in (1..3) -%}{%- case i -%}{%- when 1 -%}{%- assign pt = sd_point1 -%}{%- when 2 -%}{%- assign pt = sd_point2 -%}{%- else -%}{%- assign pt = sd_point3 -%}{%- endcase -%}{%- if pt != blank -%}<li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg><span>{{ pt | escape | replace: '[currency]', cur_html }}</span></li>{%- endif -%}{%- endfor -%}
</ul>{%- endif -%}
<div class="pg-form-c"><a href="tel:+1{{ tel | remove: '+1' }}"><em>{{ sd_phone_label }}</em><b>{{ phone }}</b></a><a href="mailto:{{ email }}"><em>{{ sd_email_label }}</em><b>{{ email }}</b></a>
{%- if sd_hours != blank -%}<span><em>{{ sd_hours_label }}</em><b>{{ sd_hours }}</b></span>{%- endif -%}</div></div>
{{ form_html }}
</div></div></section>
{%- endif -%}

{% schema %}
