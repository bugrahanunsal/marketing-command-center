{%- liquid
  assign sd_follow_label = 'grs.sd.footer.follow_label_html' | t
  assign sd_follow_label = section.settings.follow_label | default: sd_follow_label
  assign sd_contact_title = 'grs.sd.footer.contact_title_html' | t
  assign sd_contact_title = section.settings.contact_title | default: sd_contact_title
  assign sd_contact_ca = 'grs.sd.footer.contact_ca_html' | t
  assign sd_contact_ca = section.settings.contact_ca | default: sd_contact_ca
  assign sd_contact_us = 'grs.sd.footer.contact_us_html' | t
  assign sd_contact_us = section.settings.contact_us | default: sd_contact_us
  assign sd_country_title = 'grs.sd.footer.country_title_html' | t
  assign sd_country_title = section.settings.country_title | default: sd_country_title
  assign sd_language_title = 'grs.sd.footer.language_title_html' | t
  assign sd_language_title = section.settings.language_title | default: sd_language_title
  assign sd_dark_label = 'grs.sd.footer.dark_label_html' | t
  assign sd_dark_label = section.settings.dark_label | default: sd_dark_label
-%}
{%- liquid
  comment
    Labels left at their English default show the visitor's language (locale files).
  endcomment
  assign t_contact_title = sd_contact_title
  if t_contact_title == blank or t_contact_title == 'Contact Us'
    assign t_contact_title = 'grs.footer.contact_title' | t
  endif
  assign t_country_title = sd_country_title
  if t_country_title == blank or t_country_title == 'Country/region'
    assign t_country_title = 'grs.a11y.country' | t
  endif
  assign t_language_title = sd_language_title
  if t_language_title == blank or t_language_title == 'Language'
    assign t_language_title = 'grs.drawer.language' | t
  endif
  assign t_dark_label = sd_dark_label
  if t_dark_label == blank or t_dark_label == 'Dark mode'
    assign t_dark_label = 'grs.drawer.dark_mode' | t
  endif
  assign t_follow_label = sd_follow_label
  if t_follow_label == 'Follow us'
    assign t_follow_label = 'grs.footer.follow_us' | t
  endif
  assign t_contact_ca = sd_contact_ca
  if t_contact_ca == blank or t_contact_ca == 'Fast shipping across Canada and the U.S.'
    assign t_contact_ca = 'grs.footer.fast_shipping' | t
  endif
  assign t_contact_us = sd_contact_us
  if t_contact_us == blank or t_contact_us == 'Fast shipping across Canada and the U.S.'
    assign t_contact_us = 'grs.footer.fast_shipping' | t
  endif
-%}
{%- liquid
  if routes.root_url == '/'
    assign r = ''
  else
    assign r = routes.root_url
  endif
  assign grs_us = false
  if localization.market.handle == 'us' or localization.country.iso_code == 'US'
    assign grs_us = true
  endif
-%}
{%- liquid
  assign grs_phone = settings.grs_phone | default: '(855) 452-7715'
  assign grs_phone_tel = grs_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' | prepend: '+1'
-%}
<footer class="ft2"{% render 'grs-vars', s: section.settings %}><div class="wrap"><div class="ft2-top"><a class="ft2-logo" href="{{ routes.root_url }}" aria-label="{{ 'grs.a11y.home_link' | t: shop: shop.name }}">{%- assign ft_logo = section.settings.logo | default: images['the-glass-railing-store-grs-icon.webp'] -%}<img src="{{ ft_logo | image_url: width: 176 }}" alt="{{ shop.name | escape }}" width="88" height="88" loading="lazy" decoding="async"></a><div class="ft2-follow">{%- if sd_follow_label != blank -%}<span>{{ t_follow_label }}</span>{%- endif -%}{% render 'grs-social' %}</div></div>
<div class="ft2-cols">{%- for i in (1..3) -%}{%- liquid
  assign mk = 'menu_' | append: i
  assign tk = 'title_' | append: i
  assign m = section.settings[mk]
  assign t = section.settings[tk] | default: m.title
-%}{%- if m.links.size > 0 -%}<nav class="ft2-col ft2-grp" aria-label="{{ t | escape }}"><details class="ft2-acc ft-open" open=""><summary tabindex="-1"><h2 class="ft2-h">{{ t | escape }}</h2><span class="ft2-pm" aria-hidden="true"></span></summary><div class="ft2-links">{%- for l in m.links -%}{%- if l.links.size > 0 -%}<span class="ft2-sub">{{ l.title | escape }}</span>{%- for k in l.links -%}{% render 'grs-ftlink', l: k %}{%- endfor -%}{%- else -%}{% render 'grs-ftlink', l: l %}{%- endif -%}{%- endfor -%}</div></details></nav>
{%- endif -%}{%- endfor -%}
<div class="ft2-col ft2-info"><h2 class="ft2-h">{{ t_contact_title }}</h2><a class="ft2-ic" href="tel:{{ grs_phone_tel }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2a9 9 0 0 1 9 9"></path><path d="M13 6a5 5 0 0 1 5 5"></path><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path></svg>{{ grs_phone }}</a>{%- assign grs_email = settings.grs_email | default: 'info@glassrailingstore.com' -%}<a class="ft2-ic" href="mailto:{{ grs_email }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>{{ grs_email }}</a><p>{% if grs_us %}{{ t_contact_us }}{% else %}{{ t_contact_ca }}{% endif %}</p></div>
<div class="ft2-col ft2-locs"><h2 class="ft2-h">{{ t_country_title }}</h2><div class="loc-dd loc-mk"><button class="loc-btn" type="button" aria-expanded="false" aria-haspopup="true" aria-label="{{ 'grs.a11y.country' | t }}">{% if grs_us %}{% render 'grs-flag', c: 'us' %}{% else %}{% render 'grs-flag', c: 'ca' %}{% endif %}<span class="loc-lbl"><span class="loc-nm">{% if grs_us %}{{ 'grs.country.us' | t }}{% else %}{{ 'grs.country.ca' | t }}{% endif %}</span><span class="loc-cur">{% if grs_us %}USD{% else %}CAD{% endif %} $</span></span><svg width="12" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true"><path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><ul class="loc-list">{%- if localization.available_countries.size > 0 -%}{%- comment -%} Country and language together (snippets/grs-loc-rows) {%- endcomment -%}{%- render 'grs-loc-rows', id: 'grs-loc-ft' -%}{%- else -%}<li><button type="button" data-mkset="ca" data-country="CA" aria-current="{% unless grs_us %}true{% else %}false{% endunless %}"{% unless grs_us %} class="on"{% endunless %}>{% render 'grs-flag', c: 'ca' %}{{ 'grs.country.ca' | t }} <em>CAD $</em></button></li><li><button type="button" data-mkset="us" data-country="US" aria-current="{% if grs_us %}true{% else %}false{% endif %}"{% if grs_us %} class="on"{% endif %}>{% render 'grs-flag', c: 'us' %}{{ 'grs.country.us' | t }} <em>USD $</em></button></li>{%- endif -%}</ul></div>{%- render 'grs-lang-list', id: 'grs-lang-ft', kind: 'footer', title: t_language_title -%}<button class="theme-sw themebtn" type="button" role="switch" aria-checked="false"><span class="ts-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="moon"><path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5a8.5 8.5 0 1 0 10.8 10.8z"></path></svg><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="sun"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path></svg></span><span class="ts-lbl">{{ t_dark_label }}</span><span class="ts-track" aria-hidden="true"><i></i></span></button></div></div>
<div class="ft2-bot"><span>© {{ 'now' | date: '%Y' }}, {{ shop.name | escape }}</span><nav class="ft2-pol" aria-label="{{ 'grs.a11y.policies' | t }}"><a class="pol" href="{% render 'grs-url', url: '/policies/privacy-policy' %}">{{ 'grs.footer.privacy' | t }}</a><a class="pol" href="{% render 'grs-url', url: '/policies/refund-policy' %}">{{ 'grs.footer.refund' | t }}</a><a class="pol" href="{% render 'grs-url', url: '/policies/shipping-policy' %}">{{ 'grs.footer.shipping' | t }}</a><a class="pol" href="{% render 'grs-url', url: '/policies/terms-of-service' %}">{{ 'grs.footer.terms' | t }}</a><a class="pol" href="{% render 'grs-url', url: '/policies/contact-information' %}">{{ 'grs.footer.contact' | t }}</a></nav><div class="ft2-pay" aria-label="{{ 'grs.a11y.payments' | t }}">{%- for type in shop.enabled_payment_types -%}<span>{%- case type -%}{%- when 'american_express' -%}American Express{%- when 'apple_pay' -%}Apple Pay{%- when 'diners_club' -%}Diners Club{%- when 'discover' -%}Discover{%- when 'google_pay' -%}Google Pay{%- when 'master' -%}Mastercard{%- when 'paypal' -%}PayPal{%- when 'shopify_pay' -%}Shop Pay{%- when 'visa' -%}Visa{%- when 'jcb' -%}JCB{%- when 'interac' -%}Interac{%- when 'maestro' -%}Maestro{%- when 'unionpay' -%}UnionPay{%- when 'venmo' -%}Venmo{%- when 'klarna' -%}Klarna{%- when 'afterpay' -%}Afterpay{%- when 'amazon' -%}Amazon Pay{%- when 'meta_pay' -%}Meta Pay{%- when 'elo' -%}Elo{%- when 'bancontact' -%}Bancontact{%- else -%}{{ type | replace: '_', ' ' | capitalize }}{%- endcase -%}</span>{%- endfor -%}</div></div></div></footer>

{% schema %}
{
  "name": "GRS footer",
  "class": "grs-ft-sec",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty for the round GRS icon."
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo size",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "text",
      "id": "follow_label",
      "label": "Text before the social icons",
      "info": "Social links: Theme settings > Social media.",
      "placeholder": "Follow us"
    },
    {
      "type": "header",
      "content": "Link columns",
      "info": "Menus are edited in Online Store > Navigation. A menu item with links under it shows as a small title (like Locations)."
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Column 1 menu"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Column 1 title"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Column 2 menu"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Column 2 title"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Column 3 menu"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Column 3 title"
    },
    {
      "type": "header",
      "content": "Contact",
      "info": "Phone and email: Theme settings > GRS store info and menus."
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Title",
      "placeholder": "Contact Us",
      "info": "Empty: the standard text, in the visitor's language."
    },
    {
      "type": "text",
      "id": "contact_ca",
      "label": "Contact line (Canada)",
      "placeholder": "Fast shipping across Canada and the U.S.",
      "info": "Empty: the standard text, in the visitor's language."
    },
    {
      "type": "text",
      "id": "contact_us",
      "label": "Contact line (United States)",
      "placeholder": "Fast shipping across Canada and the U.S.",
      "info": "Empty: the standard text, in the visitor's language."
    },
    {
      "type": "header",
      "content": "Country, language, dark mode"
    },
    {
      "type": "text",
      "id": "country_title",
      "label": "Country title",
      "placeholder": "Country/region",
      "info": "Empty: the standard text, in the visitor's language."
    },
    {
      "type": "text",
      "id": "language_title",
      "label": "Language title",
      "placeholder": "Language",
      "info": "Empty: the standard text, in the visitor's language."
    },
    {
      "type": "text",
      "id": "dark_label",
      "label": "Dark mode switch label",
      "placeholder": "Dark mode",
      "info": "Empty: the standard text, in the visitor's language."
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
