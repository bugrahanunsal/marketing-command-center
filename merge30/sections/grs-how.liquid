{%- liquid
  assign sd_step_word = 'grs.sd.how.step_word_html' | t
  assign sd_step_word = section.settings.step_word | default: sd_step_word
-%}
{%- liquid
  if routes.root_url == '/'
    assign r = ''
  else
    assign r = routes.root_url
  endif
  assign grs_us = false
  if localization.market.handle == 'us' or localization.country.iso_code == 'US'
    assign grs_us = true
  endif
-%}
<section class="sec how2-sec"{% render 'grs-vars', s: section.settings %} aria-labelledby="how-h"><div class="wrap"><div class="sh2"><div>{%- if section.settings.eyebrow != blank -%}<span class="dot-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}<h2 class="mh2" id="how-h">{{ section.settings.heading }}</h2></div>{%- if section.settings.link_label != blank -%}<a class="arrow-link" href="{% render 'grs-url', url: section.settings.link %}">{{ section.settings.link_label }} <svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>{%- endif -%}</div><div class="xcards xcards-open">{%- liquid
  assign open_i = section.settings.open_card | default: '1' | plus: 0
  if open_i > section.blocks.size
    assign open_i = 1
  endif
-%}{%- for block in section.blocks -%}<div class="xcard xstep{% if forloop.index == open_i %} is-open{% endif %}" {{ block.shopify_attributes }}>{%- if block.settings.image -%}{% render 'grs-img', image: block.settings.image, class: 'ph', sizes: '(max-width:749px) 92vw, 33vw', widths: '500,700,900,1200' %}{%- endif -%}<div class="xcard-t"><span class="xs-n">{{ sd_step_word }} {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3><div class="xcard-more"><div class="xcard-mi">{%- if block.settings.text != blank -%}<div class="xcard-rte">{% render 'grs-rte', html: block.settings.text %}</div>{%- endif -%}{%- if block.settings.button_label != blank -%}<a class="btn white" href="{% render 'grs-url', url: block.settings.button_link %}"><span class="dot"></span>{{ block.settings.button_label }}</a>{%- endif -%}</div></div></div></div>{%- endfor -%}</div></div></section>

{% schema %}
{"name":"GRS how it works","tag":"div","settings":[{"type":"text","id":"eyebrow","label":"Small title"},{"type":"text","id":"heading","label":"Heading"},{"type":"text","id":"link_label","label":"Link label"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"step_word","label":"Word before the step number","placeholder":"Step","info":"Empty: the standard text, in the visitor's language."},{"type":"select","id":"open_card","label":"Card open at start","default":"1","options":[{"value":"1","label":"Step 1"},{"value":"2","label":"Step 2"},{"value":"3","label":"Step 3"},{"value":"4","label":"Step 4"}],"info":"On computers the other cards open when clicked. On phones every card shows its text."},{"type":"header","content":"Layout and sizes","info":"100% keeps the original design."},{"type":"range","id":"content_width","label":"Content width","min":800,"max":1800,"step":20,"default":1440,"unit":"px"},{"type":"range","id":"space_top","label":"Space above","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"range","id":"space_bottom","label":"Space below","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"image_height","label":"Card height (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"image_height_mobile","label":"Card height (phone and tablet)"},{"type":"header","content":"Text sizes and style","info":"Sizes are set separately for computers and phones. 100% keeps the original design."},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"eyebrow_size","label":"Small title size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"eyebrow_size_mobile","label":"Small title size (phone)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size","label":"Heading size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size_mobile","label":"Heading size (phone)"},{"type":"select","id":"heading_weight","label":"Heading weight","default":"default","options":[{"value":"default","label":"As designed"},{"value":"300","label":"Light"},{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}]},{"type":"select","id":"heading_case","label":"Heading letters","default":"default","options":[{"value":"default","label":"As written"},{"value":"uppercase","label":"ALL CAPITALS"}]},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"title_size","label":"Card title size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"title_size_mobile","label":"Card title size (phone)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size","label":"Text size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size_mobile","label":"Text size (phone)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_width","label":"Text width"}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"image_picker","id":"image","label":"Photo"},{"type":"text","id":"title","label":"Title"},{"type":"richtext","id":"text","label":"Text"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_link","label":"Button link"}]}],"max_blocks":4,"presets":[{"name":"GRS how it works"}]}
{% endschema %}
