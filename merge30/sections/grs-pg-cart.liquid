{%- comment -%}
  Cart page (prototype /cart view): the cart lines (photo, name, options, price, quantity, line total, remove) and the
  summary (free shipping progress, subtotal, check out, quote link). Quantity buttons and remove use Shopify's cart
  links, so they work without scripts. Empty cart: a message, a button and the main categories (blocks), with the
  help card beside them.
  Texts left empty in the theme editor show the standard texts of locales/*.json (grs.sd.pg_cart), in the
  visitor's language.
{%- endcomment -%}
{%- liquid
  assign sd_heading = 'grs.sd.pg_cart.heading_html' | t
  assign sd_heading = section.settings.heading | default: sd_heading
  assign sd_col_product = 'grs.sd.pg_cart.col_product_html' | t
  assign sd_col_product = section.settings.col_product | default: sd_col_product
  assign sd_col_quantity = 'grs.sd.pg_cart.col_quantity_html' | t
  assign sd_col_quantity = section.settings.col_quantity | default: sd_col_quantity
  assign sd_col_total = 'grs.sd.pg_cart.col_total_html' | t
  assign sd_col_total = section.settings.col_total | default: sd_col_total
  assign sd_continue_label = 'grs.sd.pg_cart.continue_label_html' | t
  assign sd_continue_label = section.settings.continue_label | default: sd_continue_label
  assign sd_empty_title = 'grs.sd.pg_cart.empty_title_html' | t
  assign sd_empty_title = section.settings.empty_title | default: sd_empty_title
  assign sd_empty_text = 'grs.sd.pg_cart.empty_text_html' | t
  assign sd_empty_text = section.settings.empty_text | default: sd_empty_text
  assign sd_cats_heading = 'grs.sd.pg_cart.cats_heading_html' | t
  assign sd_cats_heading = section.settings.cats_heading | default: sd_cats_heading
  assign sd_count_one = 'grs.sd.pg_cart.count_one_html' | t
  assign sd_count_one = section.settings.count_one | default: sd_count_one
  assign sd_count_other = 'grs.sd.pg_cart.count_other_html' | t
  assign sd_count_other = section.settings.count_other | default: sd_count_other
  assign sd_help_title = 'grs.sd.pg_cart.help_title_html' | t
  assign sd_help_title = section.settings.help_title | default: sd_help_title
  assign sd_help_text = 'grs.sd.pg_cart.help_text_html' | t
  assign sd_help_text = section.settings.help_text | default: sd_help_text
  assign sd_help_button = 'grs.sd.pg_cart.help_button_html' | t
  assign sd_help_button = section.settings.help_button | default: sd_help_button
-%}
{%- liquid
  assign grs_phone = settings.grs_phone | default: '(855) 452-7715'
  assign grs_phone_tel = grs_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' | prepend: '+1'
  assign free_at = section.settings.free_over | times: 100
  assign left = free_at | minus: cart.total_price
  assign pct = cart.total_price | times: 100 | divided_by: free_at | at_most: 100
  assign shop_url = section.settings.shop_link | default: routes.all_products_collection_url
-%}
<section class="pg-top"{% render 'grs-vars', s: section.settings %}><div class="wrap">{%- if section.settings.show_crumb -%}{% render 'grs-pg-crumb', cur: sd_heading %}{%- endif -%}<h1 class="pg-title">{{ sd_heading | escape }}</h1></div></section>
<section class="pg-body cp-body"><div class="wrap cp-grid">
{%- if cart.item_count > 0 -%}
<form class="cp-main" action="{{ routes.cart_url }}" method="post" id="cp-form-{{ section.id }}"><div class="cp-head" aria-hidden="true"><span>{{ sd_col_product | escape }}</span><span>{{ sd_col_quantity | escape }}</span><span>{{ sd_col_total | escape }}</span></div><ul class="cp-list" role="list">
{%- for item in cart.items -%}{%- liquid
  assign opts = ''
  unless item.product.has_only_default_variant
    assign opts = item.variant.title
  endunless
  assign minus = item.quantity | minus: 1
  assign plus = item.quantity | plus: 1
-%}<li class="cp-row"><a class="cp-th" href="{{ item.url }}" tabindex="-1" aria-hidden="true">{%- if item.image -%}<img class="ph" src="{{ item.image | image_url: width: 240 }}" alt="" width="120" height="120" loading="lazy" decoding="async">{%- endif -%}</a><div class="cp-info"><a class="cp-nm" href="{{ item.url }}">{{ item.product.title | escape }}</a>{%- if opts != '' -%}<span class="cp-v">{{ opts | escape }}</span>{%- endif -%}<span class="cp-each">{{ item.final_price | money }} <small>{{ cart.currency.iso_code }}</small></span></div>
<div class="qty"><a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity={{ minus }}" role="button" aria-label="{{ 'grs.a11y.decrease' | t }}">−</a><span>{{ item.quantity }}</span><a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity={{ plus }}" role="button" aria-label="{{ 'grs.a11y.increase' | t }}">+</a></div>
<b class="cp-tot">{{ item.final_line_price | money }}</b><a class="cp-rm" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0" role="button" aria-label="{{ 'grs.cart.remove' | t }} {{ item.product.title | escape }}"><svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 1l8 8M9 1L1 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></a></li>
{%- endfor -%}
</ul><a class="arrow-link" href="{{ shop_url }}">{{ sd_continue_label | escape }} <svg width="8" height="14" viewBox="0 0 8 14" fill="none" aria-hidden="true"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></form>
<aside class="cp-sum ip-card"><div class="cp-ship"><span>{%- if left > 0 -%}{%- capture grs_amt -%}{{ left | money }} {{ cart.currency.iso_code }}{%- endcapture -%}{{ 'grs.cart.ship_left' | t: amount: grs_amt }}{%- else -%}{{ 'grs.cart.ship_ok' | t }}{%- endif -%}</span><div class="bar"><b style="width:{{ pct }}%"></b></div></div>
<div class="cp-line"><span>{{ 'grs.cart.subtotal' | t }}</span><b>{{ cart.total_price | money }} {{ cart.currency.iso_code }}</b></div><p class="mut small">{{ 'grs.cart.taxes' | t }}</p>
<button type="submit" name="checkout" form="cp-form-{{ section.id }}" class="btn wide dark"><span class="dot"></span>{{ 'grs.cart.checkout' | t }}</button>
<a class="arrow-link" href="{%- if section.settings.quote_link != blank -%}{% render 'grs-url', url: section.settings.quote_link %}{%- else -%}{{ pages['contact'].url | default: '/pages/contact' }}{%- endif -%}">{{ 'grs.cart.quote' | t }} <svg width="8" height="14" viewBox="0 0 8 14" fill="none" aria-hidden="true"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></aside>
{%- else -%}
<div class="cp-main"><div class="cp-empty"><b>{{ sd_empty_title | escape }}</b>{%- if sd_empty_text != blank -%}<p>{{ sd_empty_text | escape }}</p>{%- endif -%}<a class="btn" href="{{ shop_url }}"><span class="dot"></span>{{ sd_continue_label | escape }}</a></div>
{%- if section.blocks.size > 0 -%}{%- if sd_cats_heading != blank -%}<b class="cp-ch">{{ sd_cats_heading | escape }}</b>{%- endif -%}<ul class="cp-cats" role="list">{%- for block in section.blocks -%}{%- assign c = block.settings.collection -%}{%- if c != blank -%}{%- liquid
  if c.products_count == 1
    assign cnt = sd_count_one | replace: '[count]', c.products_count
  else
    assign cnt = sd_count_other | replace: '[count]', c.products_count
  endif
  assign im = block.settings.image | default: c.image
-%}<li {{ block.shopify_attributes }}><a class="cp-cat" href="{{ c.url }}"><span class="cp-cim">{% render 'grs-img', image: im, class: 'ph', sizes: '200px', widths: '200,400', alt: '' %}</span><b>{{ c.title | escape }}</b><em>{{ cnt | escape }}</em></a></li>{%- endif -%}{%- endfor -%}</ul>{%- endif -%}</div>
<aside class="cp-sum"><div class="ip-card ip-help"><b>{{ sd_help_title | escape }}</b>{%- if sd_help_text != blank -%}<p>{{ sd_help_text | escape }}</p>{%- endif -%}<a class="ip-phone" href="tel:{{ grs_phone_tel }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"></path><path d="M21 16v2a4 4 0 0 1-4 4h-5"></path></svg>{{ grs_phone }}</a>{%- if sd_help_button != blank -%}<a class="btn" href="{%- if section.settings.quote_link != blank -%}{% render 'grs-url', url: section.settings.quote_link %}{%- else -%}{{ pages['contact'].url | default: '/pages/contact' }}{%- endif -%}"><span class="dot"></span>{{ sd_help_button | escape }}</a>{%- endif -%}</div></aside>
{%- endif -%}
</div></section>

{% schema %}
{"name":"GRS cart page","tag":"div","settings":[{"type":"checkbox","id":"show_crumb","label":"Show the breadcrumb","default":true},{"type":"text","id":"heading","label":"Title","placeholder":"Your cart","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"col_product","label":"Column: product","placeholder":"Product","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"col_quantity","label":"Column: quantity","placeholder":"Quantity","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"col_total","label":"Column: total","placeholder":"Total","info":"Empty: the standard text, in the visitor's language."},{"type":"range","id":"free_over","label":"Free shipping from (dollars)","min":500,"max":9900,"step":100,"default":3000},{"type":"text","id":"continue_label","label":"Continue shopping","placeholder":"Continue shopping","info":"Empty: the standard text, in the visitor's language."},{"type":"url","id":"shop_link","label":"Continue shopping link","info":"Empty: all products."},{"type":"url","id":"quote_link","label":"Quote link","info":"Empty: the contact page."},{"type":"header","content":"Empty cart"},{"type":"text","id":"empty_title","label":"Title","placeholder":"Your cart is empty","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"empty_text","label":"Text","placeholder":"Browse glass panels, spigots, connectors, gate hardware and caprail.","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"cats_heading","label":"Categories heading","placeholder":"Shop by category","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"count_one","label":"One product","placeholder":"[count] product","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"count_other","label":"Several products","placeholder":"[count] products","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"help_title","label":"Help card: title","placeholder":"Questions about your project?","info":"Empty: the standard text, in the visitor's language."},{"type":"textarea","id":"help_text","label":"Help card: text","placeholder":"Call or text a railing specialist, or send your measurements for a detailed quote.","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"help_button","label":"Help card: button","placeholder":"Get a free quote","info":"Empty: the standard text, in the visitor's language."},{"type":"header","content":"Layout and sizes","info":"100% keeps the original design."},{"type":"range","id":"content_width","label":"Content width","min":800,"max":1800,"step":20,"default":1440,"unit":"px"},{"type":"header","content":"Text sizes and style","info":"Sizes are set separately for computers and phones. 100% keeps the original design."},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size","label":"Heading size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size_mobile","label":"Heading size (phone)"},{"type":"select","id":"heading_weight","label":"Heading weight","default":"default","options":[{"value":"default","label":"As designed"},{"value":"300","label":"Light"},{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}]},{"type":"select","id":"heading_case","label":"Heading letters","default":"default","options":[{"value":"default","label":"As written"},{"value":"uppercase","label":"ALL CAPITALS"}]}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Photo","info":"Empty: the collection image."}]}],"max_blocks":8,"presets":[{"name":"GRS cart page"}]}
{% endschema %}