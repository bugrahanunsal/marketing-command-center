                <button type="button" class="grs-vcard__media" data-grs-play="{{ v[0] | escape }}" data-grs-title="{{ v[1] | escape }}" style="background-image:url('https://i.ytimg.com/vi/{{ v[0] | escape }}/hqdefault.jpg');" aria-label="Play video: {{ v[1] | escape }}">
                  <span class="grs-vcard__play">{{ icon_play }}</span>
                  {%- if v[2] != blank -%}<span class="grs-vcard__dur">{{ v[2] | escape }}</span>{%- endif -%}
                </button>
                <div class="grs-vcard__title">{{ v[1] | escape }}</div>
              </div>
            {%- endfor -%}
            <a class="grs-vcard grs-vcard--channel" href="{{ channel_url }}" target="_blank" rel="noopener">
              <span class="grs-vcard__media grs-vcard__channel">
                <span class="grs-vcard__play">{{ icon_play }}</span>
                <strong>Watch the other installation videos</strong>
                <small>on our YouTube channel</small>
              </span>
              <span class="grs-vcard__title">{{ shop.name | escape }} on YouTube</span>
            </a>
          </div>

          {%- if rec_collection and rec_collection.products.size > 0 -%}
            <div class="grs-card__head" style="margin:40px 0 18px;">
              <h2 class="grs-card__title" style="font-size:22px;">{{ sd_recommend_heading | default: 'Complete your railing' | escape }}</h2>
              <a class="grs-link" href="{{ rec_collection.url }}">Shop {{ rec_collection.title | escape }} {{ icon_arrow }}</a>
            </div>
            <div class="grs-grid">
              {%- for product in rec_collection.products limit: 4 -%}
                <a class="grs-tile" href="{{ product.url }}">
                  <div class="grs-tile__media">
                    {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="500" height="500">{%- else -%}{{ placeholder }}{%- endif -%}
                  </div>
                  <div class="grs-tile__body">
                    <span class="grs-tile__title">{{ product.title | escape }}</span>
                    <span class="grs-tile__price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</span>
                  </div>
                </a>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <div class="grs-pane grs-pane--orders">
          {%- if customer.orders.size == 0 -%}
            <div class="grs-card grs-empty">
              <h2>No orders yet</h2>
              <p class="grs-note">When you place an order, you'll be able to track it here step by step.</p>
              <div class="grs-actions">
                <a class="grs-btn grs-btn--primary" href="{{ shop_url }}">Shop railings</a>
                <a class="grs-btn grs-btn--outline" href="{{ quote_url }}">Get a free quote</a>
              </div>
            </div>
          {%- else -%}
            <div class="grs-orders">
              {%- for order in customer.orders -%}
                {%- liquid
                  case order.financial_status
                    when 'paid'
                      assign pay_label = 'Paid'
                      assign pay_tone = 'success'
                    when 'pending', 'unpaid', 'partially_paid', 'expired'
                      assign pay_label = 'Awaiting payment'
                      assign pay_tone = 'warning'
                    when 'refunded'
                      assign pay_label = 'Refunded'
                      assign pay_tone = 'neutral'
                    when 'partially_refunded'
                      assign pay_label = 'Partly refunded'
                      assign pay_tone = 'neutral'
                    when 'authorized'
                      assign pay_label = 'Payment authorized'
                      assign pay_tone = 'info'
                    else
                      assign pay_label = order.financial_status_label
                      assign pay_tone = 'neutral'
                  endcase
                  if order.cancelled
                    assign ful_label = 'Cancelled'
                    assign ful_tone = 'neutral'
                  elsif order.fulfillment_status == 'fulfilled'
                    assign ful_label = 'Shipped'
                    assign ful_tone = 'success'
                  elsif order.fulfillment_status == 'partial'
                    assign ful_label = 'Partly shipped'
                    assign ful_tone = 'info'
                  else
                    assign ful_label = 'Preparing'
                    assign ful_tone = 'info'
                  endif
                  assign o_track = ''
                  for li in order.line_items
                    if o_track == blank and li.fulfillment and li.fulfillment.tracking_url != blank
                      assign o_track = li.fulfillment.tracking_url
                    endif
                  endfor
                  assign reorder_ok = true
                  assign reorder_parts = ''
                  for li in order.line_items
                    if li.variant_id
                      assign reorder_parts = reorder_parts | append: li.variant_id | append: ':' | append: li.quantity | append: ','
                    else
                      assign reorder_ok = false
                    endif
                  endfor
                  if reorder_parts == blank
                    assign reorder_ok = false
                  endif
                  assign reorder_parts = reorder_parts | remove_last: ','
                -%}
                <article class="grs-card" aria-label="Order {{ order.name }}">
                  <div class="grs-order__head">
                    <div>
                      <div class="grs-order__name">Order {{ order.name }}</div>
                      <div class="grs-order__meta">Placed {{ order.created_at | date: '%B %-d, %Y' }}</div>
                    </div>
                    <div class="grs-order__pills">
                      <span class="grs-pill grs-pill--{{ pay_tone }}">{{ pay_label | escape }}</span>
                      <span class="grs-pill grs-pill--{{ ful_tone }}">{{ ful_label }}</span>
                    </div>
                  </div>
                  <ul class="grs-items" style="border-top:0;padding-top:0;">
                    {%- for li in order.line_items limit: 6 -%}
                      <li>
                        <div class="grs-items__thumb">
                          {%- if li.image -%}<img src="{{ li.image | image_url: width: 120 }}" alt="" width="56" height="56" loading="lazy">{%- else -%}{{ placeholder }}{%- endif -%}
                        </div>
                        <div>
                          <div class="grs-items__name">{{ li.title | escape }}</div>
                          <div class="grs-items__qty">Qty {{ li.quantity }}</div>
                        </div>
                      </li>
                    {%- endfor -%}
                  </ul>
                  <div class="grs-order__foot">
                    <span class="grs-order__total grs-num">{{ order.total_price | money }}</span>
                    <div class="grs-actions" style="margin-top:0;">
                      {%- if o_track != blank -%}
                        <a class="grs-btn grs-btn--primary grs-btn--small" href="{{ o_track }}" target="_blank" rel="noopener">Track package</a>
                      {%- endif -%}
                      <a class="grs-btn grs-btn--outline grs-btn--small" href="{{ order.customer_order_url | default: order.customer_url }}">View order</a>
                      {%- if reorder_ok -%}
                        <a class="grs-btn grs-btn--outline grs-btn--small" href="{{ routes.cart_url }}/{{ reorder_parts }}">Buy again</a>
                      {%- endif -%}
                    </div>
                  </div>
                </article>
              {%- endfor -%}
            </div>
            {%- if paginate.pages > 1 -%}
              <div class="grs-actions" style="justify-content:center;margin-top:24px;">
                {%- if paginate.previous -%}<a class="grs-btn grs-btn--outline grs-btn--small" href="{{ paginate.previous.url }}#orders">Newer orders</a>{%- endif -%}
                {%- if paginate.next -%}<a class="grs-btn grs-btn--outline grs-btn--small" href="{{ paginate.next.url }}#orders">Older orders</a>{%- endif -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>

        <div class="grs-pane grs-pane--install">
          <div class="grs-cols">
            <div class="grs-col">
              <div class="grs-done" data-grs-done>
                <strong>All 13 steps done. Your railing is finished!</strong>
                <p style="margin-top:4px;">Send us a photo of your project, we'd love to see it. <a href="mailto:{{ email }}?subject=My%20finished%20glass%20railing" style="font-weight:700;">Share your photos</a></p>
              </div>
              <section class="grs-card" aria-labelledby="grs-cl-{{ section.id }}">
                <div class="grs-card__head">
                  <div>
                    <div class="grs-card__kicker">{{ icon_book }}Step by step</div>
                    <h2 id="grs-cl-{{ section.id }}" class="grs-card__title">Installation checklist</h2>
                  </div>
                  <span class="grs-note grs-num"><strong data-grs-count>0</strong> of 13 done</span>
                </div>
                <div class="grs-progress" style="margin-bottom:18px;" aria-hidden="true"><span data-grs-bar></span></div>
                {%- capture steps -%}Mark the glass line|Snap a chalk line where the glass will stand.~Lay out panels and gaps|Mark each panel with a 1" gap between panels (3/4" to 2" works).~Mark the spigot positions|About 25% of the glass length in from each edge.~Drill the anchor holes|Use the spigot as a template and stay on the chalk line.~Fasten the spigots|Screw them down, keeping each one on the line.~Level the spigots|Check each spigot is straight with a magnetic level.~Set the glass|A two-person job: lower each panel into its spigots.~Match the panel heights|Bring every panel level with the tallest one.~Square up the angles|Start from the corners and align each panel.~Fit the clamps|Usually about 6" below the top of the glass.~Install the cap rail|Clean the edge, seat the gasket and press the rail on.~Hang the gate|Mount the hinges and latch.~Add the gate lock|Fit it on the outside with the recommended spacing.{%- endcapture -%}
                {%- assign step_rows = steps | split: '~' -%}
                <div class="grs-checklist" data-grs-steps>
                  {%- for row in step_rows -%}
                    {%- assign parts = row | split: '|' -%}
                    <label class="grs-check">
                      <input type="checkbox" value="{{ forloop.index }}" data-grs-step="{{ forloop.index }}" data-grs-title="{{ parts[0] | escape }}">
                      <span class="grs-check__box"><em>{{ forloop.index }}</em>{{ icon_check }}</span>
                      <span>
                        <span class="grs-check__title">{{ parts[0] }}</span>
                        <span class="grs-check__tip">{{ parts[1] }}</span>
                      </span>
                    </label>
                  {%- endfor -%}
                </div>
                <p class="grs-note" style="margin-top:16px;">Your progress is saved on this device. Full details, photos and diagrams are in the <a class="grs-link" href="{{ guide_url }}">installation guide</a>.</p>
              </section>
            </div>

            <div class="grs-col">
              <section aria-labelledby="grs-vd-{{ section.id }}">
                <h2 id="grs-vd-{{ section.id }}" class="grs-card__title" style="margin-bottom:12px;">Video guides</h2>
                {%- if videos.size > 0 -%}
                  {%- assign v = videos.first | split: '|' -%}
                  <div class="grs-video" data-grs-player style="background-image:url('https://i.ytimg.com/vi/{{ v[0] | escape }}/hqdefault.jpg');">
                    <button type="button" data-grs-play="{{ v[0] | escape }}" data-grs-title="{{ v[1] | escape }}" aria-label="Play video: {{ v[1] | escape }}"><span class="grs-video__play">{{ icon_play }}</span></button>
                  </div>
                {%- else -%}
                  <div class="grs-video" data-grs-player>
                    <iframe src="https://www.youtube-nocookie.com/embed/videoseries?list={{ yt_latest | escape }}&rel=0" title="Latest videos from our YouTube channel" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
                  </div>
                {%- endif -%}
                <ul class="grs-vlist">
                  {%- for row in videos -%}
                    {%- assign v = row | split: '|' -%}
                    <li>
                      <button type="button" class="grs-vlist__item{% if forloop.first %} is-active{% endif %}" data-grs-pick="{{ v[0] | escape }}" data-grs-title="{{ v[1] | escape }}"{% if forloop.first %} aria-current="true"{% endif %}>
                        <span class="grs-vlist__thumb" style="background-image:url('https://i.ytimg.com/vi/{{ v[0] | escape }}/mqdefault.jpg');">
                          {%- if v[2] != blank -%}<span class="grs-vcard__dur">{{ v[2] | escape }}</span>{%- endif -%}
                        </span>
                        <span class="grs-vlist__title">{{ v[1] | escape }}</span>
                      </button>
                    </li>
                  {%- endfor -%}
                  <li>
                    <button type="button" class="grs-vlist__item{% if videos.size == 0 %} is-active{% endif %}" data-grs-pick="list:{{ yt_latest | escape }}" data-grs-title="Latest videos from our YouTube channel"{% if videos.size == 0 %} aria-current="true"{% endif %}>
                      <span class="grs-vlist__thumb grs-vlist__thumb--live">{{ icon_play }}<small>Latest</small></span>
                      <span class="grs-vlist__title">Latest videos<small>Updates on its own when we post a new video</small></span>
                    </button>
                  </li>
                </ul>
                <a class="grs-ytlink" href="{{ channel_url }}" target="_blank" rel="noopener"><span class="grs-ytlink__icon">{{ icon_play }}</span><span>Watch the other installation videos on our YouTube channel</span>{{ icon_arrow }}</a>
              </section>

              <section class="grs-card" aria-labelledby="grs-tl-{{ section.id }}">
                <h2 id="grs-tl-{{ section.id }}" class="grs-card__title" style="margin-bottom:14px;">Tools you'll need</h2>
                {%- assign tools = 'Measuring tape|Level (magnetic)|Pencil and chalk line|Power drill with 1/8" and 5/16" bits|Allen key|Wrench' | split: '|' -%}
                <div class="grs-tools" style="grid-template-columns:minmax(0,1fr);" data-grs-tools>
                  {%- for tool in tools -%}
                    <label class="grs-check">
                      <input type="checkbox" value="{{ forloop.index }}" data-grs-tool="{{ forloop.index }}">
                      <span class="grs-check__box">{{ icon_check }}</span>
                      <span class="grs-check__title" style="font-weight:500;">{{ tool }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </section>

              <section class="grs-card" aria-labelledby="grs-ct-{{ section.id }}">
                <h2 id="grs-ct-{{ section.id }}" class="grs-card__title" style="margin-bottom:14px;">Care for your railing</h2>
                <ul class="grs-tips">
                  <li><span class="grs-tips__dot"></span><span><b>Glass:</b> a soft cloth and a non-abrasive glass cleaner. Skip scouring pads and razor blades.</span></li>
                  <li><span class="grs-tips__dot"></span><span><b>Hardware:</b> rinse with fresh water a few times a year, more often near pools or salt water.</span></li>
                  <li><span class="grs-tips__dot"></span><span><b>Each spring:</b> check the clamps and cap rail and re-tighten anything loose.</span></li>
                  <li><span class="grs-tips__dot"></span><span><b>Winter:</b> use a plastic shovel near the glass and rinse off de-icing salt.</span></li>
                </ul>
              </section>

              <section class="grs-card" aria-labelledby="grs-rs-{{ section.id }}">
                <h2 id="grs-rs-{{ section.id }}" class="grs-card__title" style="margin-bottom:6px;">Documents</h2>
                <ul class="grs-res">
                  <li><a href="{{ guide_url }}">Installation guide {{ icon_arrow }}</a></li>
                  <li><a href="{{ docs_url }}">Engineering documents {{ icon_arrow }}</a></li>
                  <li><a href="{% if code_page %}{{ code_page.url }}{% else %}{{ code_hub_url }}{% endif %}">Building code {{ icon_arrow }}</a></li>
                  <li><a href="{{ warranty_url }}">Warranty / No Rust Promise {{ icon_arrow }}</a></li>
                </ul>
              </section>
            </div>
          </div>
        </div>

        <div class="grs-pane grs-pane--profile">
          <div class="grs-cols">
            <div class="grs-col">
              <section class="grs-card" aria-labelledby="grs-pd-{{ section.id }}">
                <div class="grs-card__head">
                  <h2 id="grs-pd-{{ section.id }}" class="grs-card__title">Personal details</h2>
                  <a class="grs-btn grs-btn--outline grs-btn--small" href="{{ profile_url }}">{{ icon_edit }}Edit</a>
                </div>
                <dl class="grs-dl">
                  <div><dt>Name</dt><dd>{% if customer.name != blank %}{{ customer.name | escape }}{% else %}<span class="grs-muted">Not added</span>{% endif %}</dd></div>
                  <div><dt>Email</dt><dd>{{ customer.email | escape }}</dd></div>
                  <div><dt>Phone</dt><dd>{% if customer.phone != blank %}{{ customer.phone | escape }}{% else %}<span class="grs-muted">Not added</span>{% endif %}</dd></div>
                  <div><dt>Email updates</dt><dd>{% if customer.accepts_marketing %}Subscribed{% else %}Not subscribed{% endif %}</dd></div>
                </dl>
              </section>

              <section class="grs-card" aria-labelledby="grs-pa-{{ section.id }}">
                <div class="grs-card__head">
                  <h2 id="grs-pa-{{ section.id }}" class="grs-card__title">Saved addresses</h2>
                  <a class="grs-btn grs-btn--outline grs-btn--small" href="{{ profile_url }}">{{ icon_edit }}Add or edit</a>
                </div>
                {%- if customer.addresses_count > 0 -%}
                  <ul class="grs-addrs">
                    {%- for address in customer.addresses limit: 20 -%}
                      {%- liquid
                        assign is_default = false
                        if customer.default_address and address.id == customer.default_address.id
                          assign is_default = true
                        endif
                        assign addr_city = address.city | default: ''
                        if address.province_code != blank
                          assign addr_city = addr_city | append: ' ' | append: address.province_code
                        endif
                        if address.zip != blank
                          assign addr_city = addr_city | append: ' ' | append: address.zip
                        endif
                        assign addr_city = addr_city | strip
                      -%}
                      <li class="grs-addr">
                        {%- if is_default -%}<span class="grs-pill grs-pill--info">Default</span>{%- endif -%}
                        <address>
                          {%- if address.name != blank -%}<strong>{{ address.name | escape }}</strong><br>{%- endif -%}
                          {%- if address.address1 != blank -%}{{ address.address1 | escape }}<br>{%- endif -%}
                          {%- if address.address2 != blank -%}{{ address.address2 | escape }}<br>{%- endif -%}
                          {%- if addr_city != blank -%}{{ addr_city | escape }}<br>{%- endif -%}
                          {{- address.country.name | default: address.country_code | escape -}}
                          {%- if address.phone != blank -%}<br>{{ address.phone | escape }}{%- endif -%}
                        </address>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <p class="grs-note">No saved addresses yet. Add one to check out faster and see your local building code.</p>
                {%- endif -%}
              </section>
            </div>

            <div class="grs-col">
              <section class="grs-card" aria-labelledby="grs-so-{{ section.id }}">
                <h2 id="grs-so-{{ section.id }}" class="grs-card__title">Sign-in</h2>
                <p class="grs-note" style="margin-top:6px;">Signed in as <strong style="color:var(--grs-navy);">{{ customer.email | escape }}</strong></p>
                <div class="grs-actions"><a class="grs-btn grs-btn--outline grs-btn--small" href="{{ routes.account_logout_url }}">Sign out</a></div>
              </section>
              <section class="grs-card" aria-labelledby="grs-hp2-{{ section.id }}">
                <h2 id="grs-hp2-{{ section.id }}" class="grs-card__title">Need a hand?</h2>
                <div class="grs-contact">
                  <a href="tel:{{ phone_digits }}"><span class="grs-contact__icon">{{ icon_phone }}</span>{{ phone | escape }}</a>
                  <a href="mailto:{{ email }}"><span class="grs-contact__icon">{{ icon_mail }}</span>{{ email | escape }}</a>
                </div>
              </section>
            </div>
          </div>
        </div>

      </div>
    {%- endpaginate -%}
  {%- endif -%}
</div>

{%- if customer -%}
  <script>
    (function () {
      var root = document.getElementById('grs-{{ section.id }}');
      if (!root) return;
      var TABS = ['overview', 'orders', 'install', 'profile'];
      var tabs = root.querySelectorAll('[data-grs-tab]');

      function show(name, scroll) {
        if (TABS.indexOf(name) === -1) name = 'overview';
        TABS.forEach(function (t) { root.classList.toggle('grs--' + t, t === name); });
        shelfState();
        tabs.forEach(function (tab) {
          if (tab.getAttribute('data-grs-tab') === name) tab.setAttribute('aria-current', 'page');
          else tab.removeAttribute('aria-current');
        });
        if (scroll) {
          var nav = root.querySelector('.grs-tabs');
          var top = nav.getBoundingClientRect().top + window.pageYOffset - 16;
          if (window.pageYOffset > top) window.scrollTo(0, top);
        }
      }
      function fromUrl() { show((location.hash || '#overview').slice(1), false); }
      root.addEventListener('click', function (event) {
        var link = event.target.closest ? event.target.closest('[data-grs-tab], [data-grs-show]') : null;
        if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button > 0) return;
        event.preventDefault();
        var name = link.getAttribute('data-grs-tab') || link.getAttribute('data-grs-show');
        history.pushState(null, '', location.pathname + location.search + (name === 'overview' ? '' : '#' + name));
        show(name, true);
      });
      window.addEventListener('popstate', fromUrl);
      window.addEventListener('hashchange', fromUrl);
      fromUrl();

      function load(key) { try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch (e) { return []; } }
      function save(key, value) { try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) {} }

      var stepKey = 'grs-install-{{ customer.id }}';
      var toolKey = 'grs-tools-{{ customer.id }}';
      var stepInputs = root.querySelectorAll('[data-grs-step]');
      var toolInputs = root.querySelectorAll('[data-grs-tool]');
      var total = stepInputs.length;

      function refresh() {
        var done = 0, next = null;
        stepInputs.forEach(function (input) {
          if (input.checked) done += 1;
          else if (!next) next = input;
        });
        var pct = total ? Math.round((done / total) * 100) : 0;
        root.querySelectorAll('[data-grs-count]').forEach(function (el) { el.textContent = done; });
        root.querySelectorAll('[data-grs-percent]').forEach(function (el) { el.textContent = pct + '%'; });
        root.querySelectorAll('[data-grs-bar]').forEach(function (el) { el.style.width = pct + '%'; });
        var num = root.querySelector('[data-grs-next-num]');
        var title = root.querySelector('[data-grs-next-title]');
        if (num && title) {
          if (next) { num.textContent = next.value; title.textContent = next.getAttribute('data-grs-title'); }
          else { num.textContent = '✓'; title.textContent = 'All done. Enjoy your new railing!'; }
        }
        var doneBox = root.querySelector('[data-grs-done]');
        if (doneBox) doneBox.classList.toggle('is-on', done === total && total > 0);
      }
      function bind(inputs, key) {
        var saved = load(key);
        inputs.forEach(function (input) {
          input.checked = saved.indexOf(input.value) !== -1;
          input.addEventListener('change', function () {
            var values = [];
            inputs.forEach(function (i) { if (i.checked) values.push(i.value); });
            save(key, values);
            refresh();
          });
        });
      }
      bind(stepInputs, stepKey);
      bind(toolInputs, toolKey);
      refresh();

      var tracker = root.querySelector('[data-grs-tracker]');
      if (tracker) {
        var installKey = 'grs-installed-' + tracker.getAttribute('data-grs-order');
        function markInstalled(date) {
          tracker.classList.add('is-installed');
          var step = tracker.querySelector('[data-grs-install-step]');
          if (step) { step.classList.remove('is-current'); step.classList.add('is-done'); }
          var dot = tracker.querySelector('[data-grs-install-dot]');
          if (dot) dot.innerHTML = '{{ icon_check | strip_newlines }}';
          var label = tracker.querySelector('[data-grs-install-label]');
          if (label) label.textContent = date ? 'Installed ' + date : 'Installed';
        }
        try {
          var stored = localStorage.getItem(installKey);
          if (stored) markInstalled(stored);
        } catch (e) {}
        var markBtn = tracker.querySelector('[data-grs-mark]');
        if (markBtn) markBtn.addEventListener('click', function () {
          var date = new Date().toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
          try { localStorage.setItem(installKey, date); } catch (e) {}
          markInstalled(date);
        });
      }

      function embed(id, title) {
        var frame = document.createElement('iframe');
        frame.src = id.indexOf('list:') === 0
          ? 'https://www.youtube-nocookie.com/embed/videoseries?list=' + encodeURIComponent(id.slice(5)) + '&autoplay=1&rel=0'
          : 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1&rel=0';
        frame.title = title || 'Video';
        frame.allow = 'autoplay; encrypted-media; picture-in-picture';
        frame.setAttribute('allowfullscreen', '');
        return frame;
      }
      root.addEventListener('click', function (event) {
        var target = event.target.closest ? event.target.closest('[data-grs-play], [data-grs-pick]') : null;
        if (!target) return;
        var title = target.getAttribute('data-grs-title');
        var player = root.querySelector('[data-grs-player]');
        if (target.hasAttribute('data-grs-pick')) {
          if (!player) return;
          root.querySelectorAll('[data-grs-pick]').forEach(function (item) {
            var on = item === target;
            item.classList.toggle('is-active', on);
            if (on) item.setAttribute('aria-current', 'true');
            else item.removeAttribute('aria-current');
          });
          player.innerHTML = '';
          player.appendChild(embed(target.getAttribute('data-grs-pick'), title));
          if (player.getBoundingClientRect().top < 0) player.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }
        var id = target.getAttribute('data-grs-play');
        if (player && player.contains(target)) {
          player.innerHTML = '';
          player.appendChild(embed(id, title));
        } else {
          var box = document.createElement('div');
          box.className = 'grs-vcard__media';
          box.appendChild(embed(id, title));
          target.parentNode.replaceChild(box, target);
        }
      });

      var track = root.querySelector('[data-grs-shelf-track]');
      var shelfButtons = root.querySelectorAll('[data-grs-shelf]');
      function shelfState() {
        if (!track) return;
        shelfButtons.forEach(function (button) {
          var dir = Number(button.getAttribute('data-grs-shelf'));
          button.disabled = dir < 0 ? track.scrollLeft < 4 : track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
        });
      }
      if (track) {
        shelfButtons.forEach(function (button) {
          button.addEventListener('click', function () {
            track.scrollBy({ left: Number(button.getAttribute('data-grs-shelf')) * track.clientWidth * 0.9, behavior: 'smooth' });
          });
        });
        track.addEventListener('scroll', shelfState, { passive: true });
        window.addEventListener('resize', shelfState);
        shelfState();
      }
    })();
  </script>
{%- endif -%}

