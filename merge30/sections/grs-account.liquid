                  <span>Latest order · {{ latest.created_at | date: '%b %-d, %Y' }}</span>
                  <span class="grs-pill grs-pill--hero">{{ status_label }}</span>
                </div>
                <div class="grs-proj__item">
                  <div class="grs-proj__thumb">
                    {%- if first_item.image -%}
                      <img src="{{ first_item.image | image_url: width: 160 }}" alt="" width="64" height="64" loading="lazy">
                    {%- else -%}{{ placeholder }}{%- endif -%}
                  </div>
                  <div>
                    <div class="grs-proj__title">{{ first_item.title | escape }}</div>
                    <div class="grs-proj__meta">{{ latest.name }} · {{ latest.item_count }} {% if latest.item_count == 1 %}item{% else %}items{% endif %} · {{ latest.total_price | money }}</div>
                  </div>
                </div>
                <div class="grs-proj__bar" aria-hidden="true">
                  {%- for i in (1..4) -%}<span{% if i <= bar_on %} class="is-on"{% endif %}></span>{%- endfor -%}
                </div>
                <div class="grs-proj__steps" aria-hidden="true"><span>Ordered</span><span>Preparing</span><span>Shipped</span><span>Installed</span></div>
              {%- else -%}
                <div class="grs-proj__head"><span>Start your project</span><span class="grs-pill grs-pill--hero">3 steps</span></div>
                <div class="grs-proj__list">
                  <a href="{{ guide_url }}"><span>1. Measure your space<small>How we lay out panels and gaps</small></span>{{ icon_arrow }}</a>
                  <a href="{% if code_page %}{{ code_page.url }}{% else %}{{ code_hub_url }}{% endif %}"><span>2. Check your building code<small>Rules for your province or state</small></span>{{ icon_arrow }}</a>
