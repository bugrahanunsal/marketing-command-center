{%- comment -%}
  The Glass Railing Store · My Account (homeowner dashboard)
  One page with four tabs: Overview, Orders (#orders), Installation (#install)
  and Profile & addresses (#profile). Reads live data for the signed-in
  customer: orders and tracking, saved addresses and store credit.
  The installation checklist, tools list and "Mark as installed" are saved
  in the customer's browser. Changes to profile and addresses are saved on
  Shopify's secure account page, which the Edit buttons open.
  Texts left empty in the theme editor show the standard texts of locales/*.json (grs.sd.account), in the
  visitor's language.
{%- endcomment -%}
{%- liquid
  assign sd_eyebrow = 'grs.sd.account.eyebrow_html' | t
  assign sd_eyebrow = section.settings.eyebrow | default: sd_eyebrow
  assign sd_recommend_heading = 'grs.sd.account.recommend_heading_html' | t
  assign sd_recommend_heading = section.settings.recommend_heading | default: sd_recommend_heading
-%}

{%- liquid
  if routes.root_url == '/'
    assign root = ''
  else
    assign root = routes.root_url
  endif

  assign shop_url = section.settings.shop_url
  if shop_url == blank
    assign shop_url = root | append: '/collections/glass-railing'
  endif
  assign quote_url = section.settings.quote_url
  if quote_url == blank
    assign quote_url = root | append: '/pages/glass-railing-quote'
  endif
  assign guide_url = section.settings.guide_url
  if guide_url == blank
    assign guide_url = root | append: '/pages/glass-railing-installation-guide'
  endif
  assign docs_url = section.settings.docs_url
  if docs_url == blank
    assign docs_url = root | append: '/pages/glass-railing-engineering-testing'
  endif
  assign warranty_url = section.settings.warranty_url
  if warranty_url == blank
    assign warranty_url = root | append: '/pages/glass-railing-warranty'
  endif
  assign code_hub_url = section.settings.code_hub_url
  if code_hub_url == blank
    assign code_hub_url = root | append: '/pages/building-codes-glass-railing'
  endif
  assign installers_url = section.settings.installers_url
  if installers_url == blank
    assign installers_url = root | append: '/pages/glass-railing-installers'
  endif
  assign gallery_url = section.settings.gallery_url
  if gallery_url == blank
    assign gallery_url = root | append: '/pages/gallery'
  endif
  assign affiliate_url = section.settings.affiliate_url | default: 'https://glassrailingstore.goaffpro.com'
  assign phone = section.settings.phone | default: '(855) 452-7715'
  assign email = section.settings.email | default: 'info@glassrailingstore.com'
  assign claims_email = section.settings.claims_email | default: 'claims@glassrailingstore.com'
  assign warranty_years = section.settings.warranty_years | default: 10
  assign phone_digits = phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.'

  assign rec_collection = section.settings.recommend_collection
  if rec_collection == blank
    assign rec_collection = collections['glass-railing-hardware']
  endif
  assign blog = section.settings.blog
  if blog == blank
    assign blog = blogs['news']
  endif

  comment
    Video guides: "Video guide" blocks added in the theme editor, or the default list below.
    Each row is youtube_id|title|length.
  endcomment
  capture video_rows
    for block in section.blocks
      if block.type == 'video' and block.settings.video.id != blank
        echo block.settings.video.id
        echo '|'
        echo block.settings.title | default: 'Video guide' | replace: '|', '-' | replace: '~', '-'
        echo '|'
        echo block.settings.duration | remove: '|' | remove: '~'
        echo '~'
      endif
    endfor
  endcapture
  if video_rows == blank
    assign video_rows = '9Gz9k9ePXfc|How to Install Frameless Glass Railing (Full DIY Guide)|5:19~Oy_Ce2gctBI|How to Measure for Glass Railing (Before You Order)|1:55~tobK6oXzdC8|How to Install a Glass Gate Panel (Hinges, Latch & Closing Speed)|3:33~7U2m1_agaoM|Gate Latch for Glass Gates (Open, Close, Lock)|0:32'
  endif
  assign videos = video_rows | split: '~'
  assign channel_url = section.settings.channel_url | default: 'https://www.youtube.com/@GlassRailingStore/videos'

  comment
    Latest videos: YouTube keeps a list of each channel's landscape videos (no Shorts),
    newest first. Its id is the channel id with UC replaced by UULF, so new uploads show up on their own.
  endcomment
  assign yt_channel = section.settings.youtube_channel_id | default: 'UCCZBekKEU_CNWp0nK7ZNDvA' | strip
  assign yt_latest = yt_channel | replace_first: 'UC', 'UULF'

  assign account_parts = routes.account_url | split: '?'
  assign profile_url = account_parts | first | append: '/profile'
  if account_parts.size > 1
    assign profile_url = profile_url | append: '?' | append: account_parts.last
  endif
-%}

