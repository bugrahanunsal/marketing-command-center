<style>
  #grs-{{ section.id }} {
    --grs-navy: #0E1B4D;
    --grs-blue: #4770DB;
    --grs-bg: #EFF0F5;
    --grs-line: #DFE3EE;
    --grs-soft: #F6F7FB;
    --grs-muted: #5B6488;
    --grs-yellow: #FFD84D;
    background: var(--grs-bg);
    color: var(--grs-navy);
    line-height: 1.5;
    font-family: inherit;
  }
  #grs-{{ section.id }} *, #grs-{{ section.id }} *::before, #grs-{{ section.id }} *::after { box-sizing: border-box; }
  #grs-{{ section.id }} [hidden] { display: none !important; }
  #grs-{{ section.id }} h1, #grs-{{ section.id }} h2, #grs-{{ section.id }} h3, #grs-{{ section.id }} p, #grs-{{ section.id }} ol, #grs-{{ section.id }} ul, #grs-{{ section.id }} dl, #grs-{{ section.id }} dd { margin: 0; }
  #grs-{{ section.id }} ol, #grs-{{ section.id }} ul { padding: 0; list-style: none; }
  #grs-{{ section.id }} h1, #grs-{{ section.id }} h2, #grs-{{ section.id }} h3 { font-family: var(--font-heading-family, inherit); font-weight: var(--font-heading-weight, 700); letter-spacing: normal; text-transform: none; color: inherit; }
  #grs-{{ section.id }} a { color: var(--grs-navy); }
  #grs-{{ section.id }} button { font-family: inherit; margin: 0; box-shadow: none; letter-spacing: normal; text-transform: none; }
  #grs-{{ section.id }} img { display: block; max-width: 100%; }
  #grs-{{ section.id }} .grs-i { flex-shrink: 0; }
  #grs-{{ section.id }} .grs-ph { width: 100%; height: 100%; display: block; }
  #grs-{{ section.id }} .grs-wrap { max-width: 1200px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  #grs-{{ section.id }} .grs-num { font-variant-numeric: tabular-nums; }

  /* Hero */
  #grs-{{ section.id }} .grs-hero { background: var(--grs-navy); color: #FFFFFF; position: relative; overflow: hidden; }
  #grs-{{ section.id }} .grs-hero::after { content: ""; position: absolute; right: -120px; top: -160px; width: 520px; height: 520px; border-radius: 50%; background: radial-gradient(closest-side, rgba(71, 112, 219, 0.45), rgba(71, 112, 219, 0)); pointer-events: none; }
  #grs-{{ section.id }} .grs-hero__inner { position: relative; z-index: 1; padding-top: 48px; }
  #grs-{{ section.id }} .grs-hero__row { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 40px; align-items: center; }
  #grs-{{ section.id }} .grs-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--grs-yellow); }
  #grs-{{ section.id }} .grs-hero h1 { margin-top: 12px; font-size: 40px; line-height: 1.1; color: #FFFFFF; }
  #grs-{{ section.id }} .grs-hero__lead { margin-top: 14px; font-size: 16px; line-height: 1.6; color: #C8D0EA; max-width: 560px; }
  #grs-{{ section.id }} .grs-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  #grs-{{ section.id }} .grs-tabbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 40px; }
  #grs-{{ section.id }} .grs-tabs { display: flex; gap: 6px; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  #grs-{{ section.id }} .grs-session { display: flex; align-items: center; gap: 14px; flex-shrink: 0; min-width: 0; font-size: 14px; color: #C8D0EA; }
  #grs-{{ section.id }} .grs-session__who { display: inline-flex; align-items: center; gap: 8px; min-width: 0; max-width: 280px; }
  #grs-{{ section.id }} .grs-session__who span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #grs-{{ section.id }} .grs-session__out { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 40px; border: 1px solid rgba(255, 255, 255, 0.32); color: #FFFFFF; text-decoration: none; font-size: 14px; font-weight: 600; white-space: nowrap; transition: background 0.2s ease, border-color 0.2s ease; }
  #grs-{{ section.id }} .grs-session__out:hover { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.7); }
  #grs-{{ section.id }} .grs-tabs::-webkit-scrollbar { display: none; }
  #grs-{{ section.id }} .grs-tabs a { flex-shrink: 0; padding: 12px 18px; border-radius: 14px 14px 0 0; text-decoration: none; font-size: 15px; font-weight: 600; color: #C8D0EA; }
  #grs-{{ section.id }} .grs-tabs a:hover { color: #FFFFFF; }
  #grs-{{ section.id }} .grs-tabs a[aria-current="page"] { background: var(--grs-bg); color: var(--grs-navy); }

  /* Buttons */
  #grs-{{ section.id }} .grs-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; padding: 0 22px; border-radius: 40px; font-size: 15px; font-weight: 600; text-decoration: none; cursor: pointer; border: 1px solid transparent; line-height: 1.2; }
  #grs-{{ section.id }} .grs-btn--primary { background: var(--grs-blue); color: #FFFFFF; }
  #grs-{{ section.id }} .grs-btn--primary:hover { color: #FFFFFF; filter: brightness(1.06); }
  #grs-{{ section.id }} .grs-btn--white { background: #FFFFFF; color: var(--grs-navy); }
  #grs-{{ section.id }} .grs-btn--ghost { border-color: rgba(255, 255, 255, 0.55); color: #FFFFFF; background: transparent; }
  #grs-{{ section.id }} .grs-btn--ghost:hover { color: #FFFFFF; background: rgba(255, 255, 255, 0.08); }
  #grs-{{ section.id }} .grs-btn--outline { border-color: var(--grs-navy); color: var(--grs-navy); background: transparent; min-height: 40px; padding: 0 18px; font-size: 14px; }
  #grs-{{ section.id }} .grs-btn--small { min-height: 36px; padding: 0 16px; font-size: 13px; }
  #grs-{{ section.id }} .grs-link { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: var(--grs-blue); text-decoration: none; }
  #grs-{{ section.id }} .grs-link:hover { text-decoration: underline; }

  /* Project card in the hero */
  #grs-{{ section.id }} .grs-proj { background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 18px; padding: 20px; margin-bottom: 28px; backdrop-filter: blur(6px); }
  #grs-{{ section.id }} .grs-proj__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 13px; color: #C8D0EA; }
  #grs-{{ section.id }} .grs-proj__item { display: flex; align-items: center; gap: 14px; margin-top: 14px; }
  #grs-{{ section.id }} .grs-proj__thumb { width: 64px; height: 64px; border-radius: 12px; overflow: hidden; background: #FFFFFF; flex-shrink: 0; }
  #grs-{{ section.id }} .grs-proj__thumb img { width: 100%; height: 100%; object-fit: cover; }
  #grs-{{ section.id }} .grs-proj__title { font-size: 15px; font-weight: 600; color: #FFFFFF; line-height: 1.35; }
  #grs-{{ section.id }} .grs-proj__meta { font-size: 13px; color: #C8D0EA; margin-top: 2px; }
  #grs-{{ section.id }} .grs-proj__bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 18px; }
  #grs-{{ section.id }} .grs-proj__bar span { height: 6px; border-radius: 6px; background: rgba(255, 255, 255, 0.18); }
  #grs-{{ section.id }} .grs-proj__bar span.is-on { background: var(--grs-yellow); }
  #grs-{{ section.id }} .grs-proj__steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 8px; font-size: 11px; color: #C8D0EA; }
  #grs-{{ section.id }} .grs-proj__list { margin-top: 12px; display: grid; gap: 10px; }
  #grs-{{ section.id }} .grs-proj__list a { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 14px; border-radius: 12px; background: rgba(255, 255, 255, 0.08); color: #FFFFFF; text-decoration: none; font-size: 14px; font-weight: 600; }
  #grs-{{ section.id }} .grs-proj__list a:hover { background: rgba(255, 255, 255, 0.14); }
  #grs-{{ section.id }} .grs-proj__list small { display: block; font-size: 12px; font-weight: 400; color: #C8D0EA; }

  /* Pills */
  #grs-{{ section.id }} .grs-pill { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 40px; font-size: 12px; font-weight: 600; white-space: nowrap; }
  #grs-{{ section.id }} .grs-pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  #grs-{{ section.id }} .grs-pill--success { background: #E2F4EA; color: #17663A; }
  #grs-{{ section.id }} .grs-pill--info { background: #E4EBFB; color: #2D4FA8; }
  #grs-{{ section.id }} .grs-pill--warning { background: #FFF1D6; color: #8A4B00; }
  #grs-{{ section.id }} .grs-pill--neutral { background: #ECEEF4; color: #4A5272; }
  #grs-{{ section.id }} .grs-pill--hero { background: var(--grs-yellow); color: var(--grs-navy); }

  /* Panes */
  #grs-{{ section.id }} .grs-main { padding-top: 32px; padding-bottom: 72px; }
  #grs-{{ section.id }} .grs-pane { display: none; }
  #grs-{{ section.id }}.grs--overview .grs-pane--overview,
  #grs-{{ section.id }}.grs--orders .grs-pane--orders,
  #grs-{{ section.id }}.grs--install .grs-pane--install,
  #grs-{{ section.id }}.grs--profile .grs-pane--profile { display: block; }
  #grs-{{ section.id }} .grs-cols { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 24px; align-items: start; }
  #grs-{{ section.id }} .grs-col { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  #grs-{{ section.id }} .grs-card { background: #FFFFFF; border: 1px solid var(--grs-line); border-radius: 18px; padding: 24px; }
  #grs-{{ section.id }} .grs-card--flush { padding: 0; overflow: hidden; }
  #grs-{{ section.id }} .grs-card__head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px 16px; margin-bottom: 18px; }
  #grs-{{ section.id }} .grs-card__title { font-size: 20px; line-height: 1.25; }
  #grs-{{ section.id }} .grs-card__kicker { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--grs-blue); margin-bottom: 8px; }
  #grs-{{ section.id }} .grs-note { font-size: 14px; line-height: 1.6; color: var(--grs-muted); }
  #grs-{{ section.id }} .grs-section-title { font-size: 22px; margin: 40px 0 18px; }

  /* Order tracker */
  #grs-{{ section.id }} .grs-track { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 6px 0 22px; }
  #grs-{{ section.id }} .grs-track li { position: relative; padding-top: 40px; padding-right: 10px; }
  #grs-{{ section.id }} .grs-track li::before { content: ""; position: absolute; top: 15px; left: 32px; right: -2px; height: 3px; border-radius: 3px; background: var(--grs-line); }
  #grs-{{ section.id }} .grs-track li:last-child::before { display: none; }
  #grs-{{ section.id }} .grs-track li.is-done::before { background: var(--grs-blue); }
  #grs-{{ section.id }} .grs-track__dot { position: absolute; top: 0; left: 0; width: 32px; height: 32px; border-radius: 50%; background: var(--grs-soft); border: 2px solid var(--grs-line); color: var(--grs-muted); display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; }
  #grs-{{ section.id }} .grs-track li.is-done .grs-track__dot { background: var(--grs-blue); border-color: var(--grs-blue); color: #FFFFFF; }
  #grs-{{ section.id }} .grs-track li.is-current .grs-track__dot { background: #FFFFFF; border-color: var(--grs-blue); color: var(--grs-blue); box-shadow: 0 0 0 5px rgba(71, 112, 219, 0.15); }
  #grs-{{ section.id }} .grs-track strong { display: block; font-size: 14px; }
  #grs-{{ section.id }} .grs-track span:not(.grs-track__dot) { display: block; font-size: 13px; color: var(--grs-muted); }
  #grs-{{ section.id }} .grs-items { display: grid; gap: 12px; padding-top: 18px; border-top: 1px solid var(--grs-line); }
  #grs-{{ section.id }} .grs-items li { display: flex; align-items: center; gap: 14px; }
