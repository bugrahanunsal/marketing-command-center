{%- comment -%}
  Products of a collection in a row that scrolls (prototype .pg-feat; the slider script is in grs.js): heading, text,
  the products and a "View all" button. The live location pages' "Featured collection" sections.
  Texts left empty in the theme editor show the standard texts of locales/*.json (grs.sd.pg_feat), in the
  visitor's language.
{%- endcomment -%}
{%- liquid
  assign sd_view_all_label = 'grs.sd.pg_feat.view_all_label_html' | t
  assign sd_view_all_label = section.settings.view_all_label | default: sd_view_all_label
-%}
{%- liquid
  assign c = section.settings.collection | default: collections['glass-railing']
  assign n = section.settings.products_to_show | default: 8
  assign label = section.settings.title | strip_html | strip
  if label == ''
    assign label = c.title
  endif
-%}
<section class="sec pg-feat"{% render 'grs-vars', s: section.settings %}><div class="wrap">
{%- if section.settings.title != blank or section.settings.description != blank -%}<div class="pg-feat-h">
{%- if section.settings.title != blank -%}<h2 class="mh2">{{ section.settings.title }}</h2>{%- endif -%}
{%- if section.settings.description != blank -%}<div class="rte">{% render 'grs-rte', html: section.settings.description %}</div>{%- endif -%}
</div>{%- endif -%}
<div class="ps"><div class="ps-track" role="list" aria-label="{{ label | escape }}">{%- for p in c.products limit: n -%}{% render 'grs-card', product: p, li: true %}{%- endfor -%}</div><button class="ps-btn prev" type="button" aria-label="{{ 'grs.a11y.prev_products' | t }}" disabled=""><svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M7 1L1 7l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button class="ps-btn next" type="button" aria-label="{{ 'grs.a11y.next_products' | t }}"><svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div>
{%- if section.settings.show_view_all and sd_view_all_label != blank -%}<div class="pg-va"><a class="btn btn-o" href="{% render 'grs-url', url: c.url %}"><span class="dot"></span>{{ sd_view_all_label }}</a></div>{%- endif -%}
</div></section>

{% schema %}
{"name":"GRS featured products","tag":"div","settings":[{"type":"inline_richtext","id":"title","label":"Heading"},{"type":"richtext","id":"description","label":"Text"},{"type":"collection","id":"collection","label":"Collection","info":"Empty: All Products (glass-railing)."},{"type":"range","id":"products_to_show","label":"Number of products","min":2,"max":24,"step":1,"default":8},{"type":"checkbox","id":"show_view_all","label":"Show the \"View all\" button","default":true},{"type":"text","id":"view_all_label","label":"\"View all\" button","placeholder":"View all","info":"Empty: the standard text, in the visitor's language."},{"type":"header","content":"Layout and sizes","info":"100% keeps the original design."},{"type":"range","id":"content_width","label":"Content width","min":800,"max":1800,"step":20,"default":1440,"unit":"px"},{"type":"range","id":"space_top","label":"Space above","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"range","id":"space_bottom","label":"Space below","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"header","content":"Text sizes and style","info":"Sizes are set separately for computers and phones. 100% keeps the original design."},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size","label":"Heading size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size_mobile","label":"Heading size (phone)"},{"type":"select","id":"heading_weight","label":"Heading weight","default":"default","options":[{"value":"default","label":"As designed"},{"value":"300","label":"Light"},{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}]},{"type":"select","id":"heading_case","label":"Heading letters","default":"default","options":[{"value":"default","label":"As written"},{"value":"uppercase","label":"ALL CAPITALS"}]},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size","label":"Text size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size_mobile","label":"Text size (phone)"}],"presets":[{"name":"GRS featured products"}]}
{% endschema %}