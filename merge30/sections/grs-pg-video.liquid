{%- comment -%}
  Video (prototype .pg-video-sec, the live "Video" section): a cover photo that opens the video on YouTube in a new tab
  (no YouTube player loads on the page).
  Texts left empty in the theme editor show the standard texts of locales/*.json (grs.sd.pg_video), in the
  visitor's language.
{%- endcomment -%}
{%- liquid
  assign sd_label = 'grs.sd.pg_video.label_html' | t
  assign sd_label = section.settings.label | default: sd_label
-%}
{%- if section.settings.video_url != blank -%}
<section class="sec pg-video-sec"{% render 'grs-vars', s: section.settings %}><div class="wrap">
{%- if section.settings.heading != blank -%}<h2 class="mh2">{{ section.settings.heading }}</h2>{%- endif -%}
{%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
<a class="player pg-player" href="{{ section.settings.video_url }}" target="_blank" rel="noopener" aria-label="{{ 'grs.a11y.watch_video' | t }}">{% render 'grs-img', image: section.settings.image, class: 'ph', sizes: '(min-width: 1200px) 1100px, 100vw', widths: '600,900,1100,1400', alt: '' %}<span class="play"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"></path></svg></span>{%- if sd_label != blank -%}<span class="mono yt">{{ sd_label | escape }}</span>{%- endif -%}</a>
</div></section>
{%- endif -%}

{% schema %}
{"name":"GRS video","tag":"div","settings":[{"type":"inline_richtext","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Text"},{"type":"url","id":"video_url","label":"YouTube link","info":"Opens in a new tab. Empty: the section is hidden."},{"type":"image_picker","id":"image","label":"Cover photo"},{"type":"text","id":"label","label":"Label on the photo","placeholder":"Watch on YouTube","info":"Empty: the standard text, in the visitor's language."},{"type":"header","content":"Layout and sizes","info":"100% keeps the original design."},{"type":"range","id":"content_width","label":"Content width","min":800,"max":1800,"step":20,"default":1440,"unit":"px"},{"type":"range","id":"space_top","label":"Space above","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"range","id":"space_bottom","label":"Space below","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"header","content":"Text sizes and style","info":"Sizes are set separately for computers and phones. 100% keeps the original design."},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size","label":"Heading size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size_mobile","label":"Heading size (phone)"},{"type":"select","id":"heading_weight","label":"Heading weight","default":"default","options":[{"value":"default","label":"As designed"},{"value":"300","label":"Light"},{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}]},{"type":"select","id":"heading_case","label":"Heading letters","default":"default","options":[{"value":"default","label":"As written"},{"value":"uppercase","label":"ALL CAPITALS"}]},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size","label":"Text size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size_mobile","label":"Text size (phone)"}],"presets":[{"name":"GRS video"}]}
{% endschema %}