{%- comment -%}
  "You may also like" slider (prototype .sec.light / #pmore): products of the product's main collection, then the extra
  products of the section settings that are not in the list yet.
  Texts left empty in the theme editor show the standard texts of locales/*.json (grs.sd.product_related), in the
  visitor's language.
{%- endcomment -%}
{%- liquid
  assign sd_heading = 'grs.sd.product_related.heading_html' | t
  assign sd_heading = section.settings.heading | default: sd_heading
  assign sd_link_label = 'grs.sd.product_related.link_label_html' | t
  assign sd_link_label = section.settings.link_label | default: sd_link_label
-%}
{%- liquid
  comment
    Labels left at their English default show the visitor's language (locale files).
  endcomment
  assign t_heading = sd_heading
  if t_heading == blank or t_heading == 'You may also like'
    assign t_heading = 'grs.product.you_may_like' | t
  endif
  assign t_link_label = sd_link_label
  if t_link_label == 'Shop the collection'
    assign t_link_label = 'grs.product.shop_collection' | t
  endif
-%}
{%- liquid
  assign p = product
  assign src = section.settings.collection
  if src == blank
    assign src = collection
  endif
  if src == blank
    assign pref = section.settings.crumb_order | split: ','
    for h in pref
      assign hh = h | strip
      if src == blank
        for c in p.collections
          if c.handle == hh
            assign src = c
            break
          endif
        endfor
      endif
    endfor
  endif
  if src == blank
    assign src = p.collections.first
  endif
  assign lim = section.settings.max_items | default: 8
  assign seen = '|' | append: p.handle | append: '|'
  assign n = 0
-%}
<section class="sec light"{% render 'grs-vars', s: section.settings %}><div class="wrap"><div class="ps-head"><h2 class="h2">{{ t_heading }}</h2>{%- if sd_link_label != blank and src -%}<a class="arrow-link" id="pmorel" href="{{ src.url }}">{{ t_link_label }} <svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>{%- endif -%}</div><div class="ps"><div class="ps-track" id="pmore" role="list" aria-label="{{ t_heading | escape }}">
{%- if src -%}{%- for x in src.products limit: 24 -%}{%- liquid
    assign key = '|' | append: x.handle | append: '|'
    if seen contains key or n >= lim
      continue
    endif
    assign seen = seen | append: x.handle | append: '|'
    assign n = n | plus: 1
  -%}{% render 'grs-card', product: x, li: true %}{%- endfor -%}{%- endif -%}
{%- for x in section.settings.extra -%}{%- liquid
    assign key = '|' | append: x.handle | append: '|'
    if seen contains key or n >= lim
      continue
    endif
    assign seen = seen | append: x.handle | append: '|'
    assign n = n | plus: 1
  -%}{% render 'grs-card', product: x, li: true %}{%- endfor -%}
</div><button class="ps-btn prev" type="button" aria-label="{{ 'grs.a11y.prev_products' | t }}" disabled><svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M7 1L1 7l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button class="ps-btn next" type="button" aria-label="{{ 'grs.a11y.next_products' | t }}"><svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></div></section>

{% schema %}
{"name":"GRS related products","tag":"div","settings":[{"type":"text","id":"heading","label":"Heading","placeholder":"You may also like","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"link_label","label":"Link to the collection","placeholder":"Shop the collection","info":"Empty: the standard text, in the visitor's language."},{"type":"collection","id":"collection","label":"Collection","info":"Leave empty to use the product's collection (the breadcrumb collection)."},{"type":"text","id":"crumb_order","label":"Collection order","default":"glass-panel-railing, glass-railing-hardware, glass-railing-gate-hardware, glass-railing-caprail, glass-deck-railing, glass-railing","info":"Used when no collection is picked."},{"type":"product_list","id":"extra","label":"Products added after the collection","limit":12},{"type":"range","id":"max_items","label":"Number of products","min":2,"max":16,"step":1,"default":8},{"type":"header","content":"Layout and sizes","info":"100% keeps the original design."},{"type":"range","id":"content_width","label":"Content width","min":800,"max":1800,"step":20,"default":1440,"unit":"px"},{"type":"range","id":"space_top","label":"Space above","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"range","id":"space_bottom","label":"Space below","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"range","id":"columns","label":"Products per row on computer","min":2,"max":6,"step":1,"default":3,"info":"Phones and tablets keep their own layout."},{"type":"header","content":"Text sizes and style","info":"Sizes are set separately for computers and phones. 100% keeps the original design."},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size","label":"Heading size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size_mobile","label":"Heading size (phone)"},{"type":"select","id":"heading_weight","label":"Heading weight","default":"default","options":[{"value":"default","label":"As designed"},{"value":"300","label":"Light"},{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}]},{"type":"select","id":"heading_case","label":"Heading letters","default":"default","options":[{"value":"default","label":"As written"},{"value":"uppercase","label":"ALL CAPITALS"}]},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"title_size","label":"Product name size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"title_size_mobile","label":"Product name size (phone)"}]}
{% endschema %}