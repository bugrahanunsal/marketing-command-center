{%- comment -%}
  FAQ page (prototype FAQ hub): a search box and the list of topics on the side, the questions grouped by topic, each
  opening and closing (assets/grs.js, .acc-q), and the page's FAQPage data for search engines.
  Shown only on the pages named in "Pages" (default: faq); on those pages the page text itself is not shown
  (sections/grs-pg-main, "Pages that show the FAQ instead of their text"), only its title.
  Content: "Topic" blocks start a group, the "Question" blocks after a topic belong to it.
  Texts left empty in the theme editor show the standard texts of locales/*.json (grs.sd.pg_faqhub), in the
  visitor's language.
{%- endcomment -%}
{%- liquid
  assign sd_intro = 'grs.sd.pg_faqhub.intro_html' | t
  assign sd_intro = section.settings.intro | default: sd_intro
  assign sd_search_label = 'grs.sd.pg_faqhub.search_label_html' | t
  assign sd_search_label = section.settings.search_label | default: sd_search_label
  assign sd_search_placeholder = 'grs.sd.pg_faqhub.search_placeholder_html' | t
  assign sd_search_placeholder = section.settings.search_placeholder | default: sd_search_placeholder
  assign sd_topics_label = 'grs.sd.pg_faqhub.topics_label_html' | t
  assign sd_topics_label = section.settings.topics_label | default: sd_topics_label
  assign sd_no_results = 'grs.sd.pg_faqhub.no_results_html' | t
  assign sd_no_results = section.settings.no_results | default: sd_no_results
  assign sd_no_results_link = 'grs.sd.pg_faqhub.no_results_link_html' | t
  assign sd_no_results_link = section.settings.no_results_link | default: sd_no_results_link
  assign sd_help_title = 'grs.sd.pg_faqhub.help_title_html' | t
  assign sd_help_title = section.settings.help_title | default: sd_help_title
  assign sd_help_text = 'grs.sd.pg_faqhub.help_text_html' | t
  assign sd_help_text = section.settings.help_text | default: sd_help_text
  assign sd_button_label = 'grs.sd.pg_faqhub.button_label_html' | t
  assign sd_button_label = section.settings.button_label | default: sd_button_label
-%}
{%- liquid
  assign show = false
  assign hs = section.settings.pages | default: 'faq' | split: ','
  for x in hs
    assign xh = x | strip
    if xh == page.handle
      assign show = true
    endif
  endfor
  assign grs_us = false
  if localization.market.handle == 'us' or localization.country.iso_code == 'US'
    assign grs_us = true
  endif
  assign grs_phone = settings.grs_phone | default: '(855) 452-7715'
  assign grs_phone_tel = grs_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' | prepend: '+1'
-%}
{%- if show -%}
{%- liquid
  assign counts = ''
  assign c = 0
  assign started = false
  for block in section.blocks
    if block.type == 'group'
      if started
        assign counts = counts | append: c | append: ','
      endif
      assign started = true
      assign c = 0
    elsif block.settings.question != blank and block.settings.answer != blank
      assign c = c | plus: 1
    endif
  endfor
  if started
    assign counts = counts | append: c
  endif
  assign cn = counts | split: ','
  assign total = 0
  for x in cn
    assign total = total | plus: x
  endfor
-%}
<style>
.fqh-sec{padding:calc(clamp(8px,1.4vw,20px)*var(--grs-pt,1)) 0 calc(clamp(64px,7vw,110px)*var(--grs-pb,1))}
.fqh{display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:clamp(32px,5vw,80px);align-items:start}
.fqh-side{position:sticky;top:calc(var(--hdh,155px) + 24px);display:flex;flex-direction:column;gap:20px;min-width:0}
.fqh-intro{margin:0 0 clamp(24px,2.6vw,36px);color:var(--fg2);font-size:calc(clamp(16px,1.15vw,18px)*var(--grs-ts,1));line-height:1.6;max-width:44em}
.fqh-search{position:relative;display:block}
.fqh-search svg{position:absolute;left:18px;top:50%;margin-top:-9px;color:var(--fg2);pointer-events:none}
.fqh-search input{width:100%;height:52px;padding:0 18px 0 48px;border:1px solid var(--line);border-radius:999px;background:var(--card);color:var(--fg);font:inherit;font-size:15px;outline:none;transition:border-color .2s ease,box-shadow .2s ease}
.fqh-search input:focus{border-color:var(--fg);box-shadow:0 0 0 3px color-mix(in srgb,var(--acc) 45%,transparent)}
.fqh-cats{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}
.fqh-cats a{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 14px;border-radius:12px;color:var(--fg2);font-size:15px;line-height:1.3;text-decoration:none;transition:background-color .2s ease,color .2s ease}
.fqh-cats a em{font-style:normal;font-size:12px;min-width:26px;height:22px;padding:0 7px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;background:var(--stage);color:var(--fg2)}
.fqh-cats a:hover{background:var(--card);color:var(--fg)}
.fqh-cats a.on{background:var(--card);color:var(--fg);font-weight:500;box-shadow:inset 3px 0 0 var(--acc)}
.fqh-cats a.on em{background:var(--acc);color:#2b2b2b}
.fqh-cats li.is-empty{display:none}
.fqh-g{scroll-margin-top:calc(var(--hdh,155px) + 24px)}
.fqh-g+.fqh-g{margin-top:clamp(36px,3.6vw,52px)}
.fqh-g[hidden]{display:none}
.fqh-gt{display:flex;align-items:baseline;gap:12px;margin:0 0 16px;font-size:calc(clamp(22px,1.8vw,28px)*var(--grs-hs,1));font-weight:500;letter-spacing:-.015em;line-height:1.2}
.fqh-gt em{font-style:normal;font-size:13px;font-weight:400;color:var(--fg2);letter-spacing:0}
.fqh-list{display:flex;flex-direction:column;gap:10px}
.fqh .acc{background:var(--card);border:0!important;border-radius:14px;padding:0 clamp(16px,1.6vw,24px);box-shadow:0 1px 2px #0000000a,0 8px 24px #00000008;transition:box-shadow .3s ease}
.fqh .acc:hover{box-shadow:0 1px 2px #0000000d,0 12px 32px #0000000f}
.fqh .acc[hidden]{display:none}
.fqh .acc-q{min-height:62px;padding:15px 0;gap:16px;font-size:calc(16.5px*var(--grs-cs,1));font-weight:500;line-height:1.4;letter-spacing:0!important;color:var(--fg)}
.fqh .pm{flex:0 0 30px;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--stage);color:var(--fg)}
.fqh .pm svg{width:11px;height:11px}
.fqh .pm .v{transform-origin:center;transition:transform .3s ease}
.fqh .acc.open .pm{background:var(--acc)!important;color:#2b2b2b!important}
.fqh .acc-a>div>*{max-width:46em}
.fqh .acc-a p,.fqh .acc-a li{font-size:calc(15.5px*var(--grs-ts,1));line-height:1.65;color:var(--fg2)}
.fqh .acc-a p{margin:0 0 14px}
.fqh .acc-a>div>:last-child{margin-bottom:20px}
.fqh .acc-a a{color:var(--fg);text-decoration:underline;text-underline-offset:3px}
.fqh-none{margin:0;padding:28px clamp(18px,2vw,28px);border-radius:14px;background:var(--card);color:var(--fg2);font-size:15.5px;line-height:1.6}
.fqh-none a{color:var(--fg);text-decoration:underline}
.fqh-none[hidden]{display:none}
.fqh mark{background:color-mix(in srgb,var(--acc) 60%,transparent);color:inherit;border-radius:3px;padding:0 1px}
@media(max-width:989px){.fqh{grid-template-columns:minmax(0,1fr);gap:28px}.fqh-side{position:static;gap:14px}.fqh-cats{flex-direction:row;overflow-x:auto;gap:8px;margin:0 calc(-1 * var(--g,16px));padding:0 var(--g,16px) 4px;scrollbar-width:none}.fqh-cats::-webkit-scrollbar{display:none}.fqh-cats a{white-space:nowrap;padding:9px 14px;background:var(--card);border:1px solid var(--line)}.fqh-cats a.on{box-shadow:none;border-color:var(--fg)}.fqh-side .ip-help{display:none}.fqh-help-m{display:block!important;margin-top:36px}}
.fqh-help-m{display:none}
</style>
<section class="fqh-sec"{% render 'grs-vars', s: section.settings %}>{%- if sd_intro != blank -%}<div class="wrap"><p class="fqh-intro">{{ sd_intro | replace: '[count]', total }}</p></div>{%- endif -%}<div class="wrap fqh" data-fqh>
<aside class="fqh-side">
<label class="fqh-search"><span class="sr">{{ sd_search_label | escape }}</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input type="search" data-fqh-q placeholder="{{ sd_search_placeholder | escape }}" autocomplete="off"></label>
<nav aria-label="{{ sd_topics_label | escape }}"><ul class="fqh-cats" role="list">
{%- assign gi = 0 -%}{%- for block in section.blocks -%}{%- if block.type == 'group' -%}<li><a href="#fq-{{ block.settings.title | handleize }}" data-fqh-c="{{ gi }}"{% if gi == 0 %} class="on"{% endif %}><span>{{ block.settings.title | escape }}</span><em>{{ cn[gi] }}</em></a></li>{%- assign gi = gi | plus: 1 -%}{%- endif -%}{%- endfor -%}
</ul></nav>
{%- capture help -%}{%- if sd_help_title != blank -%}<div class="ip-card ip-help"><b>{{ sd_help_title | escape }}</b>{%- if sd_help_text != blank -%}<p>{{ sd_help_text | escape }}</p>{%- endif -%}<a class="ip-phone" href="tel:{{ grs_phone_tel }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"></path><path d="M21 16v2a4 4 0 0 1-4 4h-5"></path></svg>{{ grs_phone }}</a>{%- if sd_button_label != blank -%}<a class="btn" href="{%- if section.settings.button_link != blank -%}{% render 'grs-url', url: section.settings.button_link %}{%- else -%}{{ pages['contact'].url | default: '/pages/contact' }}{%- endif -%}"><span class="dot"></span>{{ sd_button_label | escape }}</a>{%- endif -%}</div>{%- endif -%}{%- endcapture -%}
{{ help }}
</aside>
<div class="fqh-main">
{%- assign open_g = false -%}{%- assign gi = 0 -%}{%- assign qs = '' -%}
{%- for block in section.blocks -%}
{%- if block.type == 'group' -%}
{%- if open_g -%}</div></section>{%- endif -%}
<section class="fqh-g" id="fq-{{ block.settings.title | handleize }}" data-fqh-g="{{ gi }}" {{ block.shopify_attributes }}><h2 class="fqh-gt">{{ block.settings.title | escape }}<em>{{ cn[gi] }}</em></h2><div class="fqh-list">
{%- assign open_g = true -%}{%- assign gi = gi | plus: 1 -%}
{%- else -%}{%- liquid
  assign a = block.settings.answer
  if grs_us and block.settings.answer_us != blank
    assign a = block.settings.answer_us
  endif
-%}{%- if block.settings.question != blank and a != blank -%}
{%- assign qs = qs | append: block.settings.question | append: '␞' | append: a | append: '␝' -%}
<div class="acc" {{ block.shopify_attributes }}><h3 class="acc-h"><button type="button" class="acc-q" aria-expanded="false"><span>{{ block.settings.question | escape }}</span><span class="pm" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M1 7h12"></path><path class="v" d="M7 1v12"></path></svg></span></button></h3><div class="acc-a"><div>{% render 'grs-rte', html: a %}</div></div></div>
{%- endif -%}{%- endif -%}
{%- endfor -%}
{%- if open_g -%}</div></section>{%- endif -%}
<p class="fqh-none" data-fqh-none hidden>{{ sd_no_results }} <a href="{%- if section.settings.button_link != blank -%}{% render 'grs-url', url: section.settings.button_link %}{%- else -%}{{ pages['contact'].url | default: '/pages/contact' }}{%- endif -%}">{{ sd_no_results_link | escape }}</a></p>
<div class="fqh-help-m">{{ help }}</div>
</div></div></section>
<script>(function(){var r=document.currentScript.previousElementSibling,box=r&&r.querySelector("[data-fqh]");if(!box)return;var q=box.querySelector("[data-fqh-q]"),gs=[].slice.call(box.querySelectorAll("[data-fqh-g]")),cs=[].slice.call(box.querySelectorAll("[data-fqh-c]")),none=box.querySelector("[data-fqh-none]");function setOn(i){cs.forEach(function(a,k){a.classList.toggle("on",k===i)})}function norm(s){return(s||"").toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g,"")}gs.forEach(function(g){[].slice.call(g.querySelectorAll(".acc")).forEach(function(a){a._t=norm(a.textContent)})});function run(){var t=norm(q.value).trim(),words=t.split(/\s+/).filter(Boolean),any=0;gs.forEach(function(g,i){var n=0;[].slice.call(g.querySelectorAll(".acc")).forEach(function(a){var ok=!words.length||words.every(function(w){return a._t.indexOf(w)>=0});a.hidden=!ok;if(ok)n++});g.hidden=!n;var li=cs[i]&&cs[i].parentNode;if(li)li.classList.toggle("is-empty",!n);var em=cs[i]&&cs[i].querySelector("em");if(em)em.textContent=n;any+=n});none.hidden=!!any}var tm;q.addEventListener("input",function(){clearTimeout(tm);tm=setTimeout(run,120)});cs.forEach(function(a,i){a.addEventListener("click",function(){setOn(i)})});if("IntersectionObserver"in window){var vis={};var io=new IntersectionObserver(function(es){es.forEach(function(e){vis[e.target.getAttribute("data-fqh-g")]=e.isIntersecting});for(var i=0;i<gs.length;i++){if(vis[i]){setOn(i);break}}},{rootMargin:"-30% 0px -60% 0px"});gs.forEach(function(g){io.observe(g)})}var h=location.hash&&box.querySelector(location.hash.replace(/[^#\w-]/g,""));if(h&&h.classList.contains("fqh-g")){var k=+h.getAttribute("data-fqh-g");setOn(k)}})();</script>
{%- if section.settings.faq_schema and qs != '' -%}{%- assign rows = qs | split: '␝' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for r in rows -%}{%- assign qa = r | split: '␞' -%}{%- if qa[0] != blank -%}{% unless forloop.first %},{% endunless %}{"@type":"Question","name":{{ qa[0] | strip_html | strip | json }},"acceptedAnswer":{"@type":"Answer","text":{{ qa[1] | strip_html | strip | json }}}}{%- endif -%}{%- endfor -%}]}</script>
{%- endif -%}
{%- endif -%}

{% schema %}
{"name":"GRS FAQ page","tag":"div","class":"grs-faqhub-sec","settings":[{"type":"paragraph","content":"The FAQ page: a search box, the topics on the side and the questions grouped by topic. A \"Topic\" block starts a group; the questions after it belong to that topic."},{"type":"text","id":"pages","label":"Pages","default":"faq","info":"Page handles separated by commas. Only these pages show this section; their page text is not shown."},{"type":"textarea","id":"intro","label":"Text above the questions","info":"[count] is the number of questions.","placeholder":"Answers about our glass panels and hardware, installation, shipping, warranty and returns. [count] questions."},{"type":"text","id":"search_label","label":"Search label (screen readers)","placeholder":"Search the questions","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"search_placeholder","label":"Search box text","placeholder":"Search the questions…","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"topics_label","label":"Topics label (screen readers)","placeholder":"Topics","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"no_results","label":"No match text","placeholder":"No question matches your search.","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"no_results_link","label":"No match link","placeholder":"Ask us your question","info":"Empty: the standard text, in the visitor's language."},{"type":"header","content":"Help card"},{"type":"text","id":"help_title","label":"Title","info":"Empty: no help card.","placeholder":"Questions about your project?"},{"type":"textarea","id":"help_text","label":"Text","placeholder":"Call or text a railing specialist, or send your measurements for a detailed quote.","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"button_label","label":"Button","placeholder":"Get a free quote","info":"Empty: the standard text, in the visitor's language."},{"type":"url","id":"button_link","label":"Button link","info":"Empty: the contact page."},{"type":"checkbox","id":"faq_schema","label":"Add the FAQ data (FAQPage) for search engines","default":true},{"type":"header","content":"Layout and sizes","info":"100% keeps the original design."},{"type":"range","id":"content_width","label":"Content width","min":800,"max":1800,"step":20,"default":1440,"unit":"px"},{"type":"range","id":"space_top","label":"Space above","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"range","id":"space_bottom","label":"Space below","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"header","content":"Text sizes and style","info":"Sizes are set separately for computers and phones. 100% keeps the original design."},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size","label":"Topic title size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size_mobile","label":"Topic title size (phone)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"title_size","label":"Question size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"title_size_mobile","label":"Question size (phone)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size","label":"Text size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size_mobile","label":"Text size (phone)"}],"blocks":[{"type":"group","name":"Topic","settings":[{"type":"text","id":"title","label":"Topic"}]},{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question"},{"type":"richtext","id":"answer","label":"Answer"},{"type":"richtext","id":"answer_us","label":"Answer in the U.S. (optional)"}]}],"max_blocks":50,"presets":[{"name":"GRS FAQ page"}]}
{% endschema %}
