{%- comment -%}
  Installation videos (prototype .vsec / .vfx): the first video large, the others as a list. YouTube links.
  Texts left empty in the theme editor show the standard texts of locales/*.json (grs.sd.videos), in the
  visitor's language.
{%- endcomment -%}
{%- liquid
  assign sd_watch_label = 'grs.sd.videos.watch_label_html' | t
  assign sd_watch_label = section.settings.watch_label | default: sd_watch_label
  assign sd_link_label = 'grs.sd.videos.link_label_html' | t
  assign sd_link_label = section.settings.link_label | default: sd_link_label
-%}
{%- liquid
  comment
    Labels left at their English default show the visitor's language (locale files).
  endcomment
  assign t_watch_label = sd_watch_label
  if t_watch_label == blank or t_watch_label == 'Watch'
    assign t_watch_label = 'grs.general.watch' | t
  endif
  assign t_link_label = sd_link_label
  if t_link_label == blank or t_link_label == 'Watch on YouTube'
    assign t_link_label = 'grs.general.watch_youtube' | t
  endif
-%}
<section class="sec vsec"{% render 'grs-vars', s: section.settings %}><div class="wrap"><div class="vsec-head"><div>{%- if section.settings.eyebrow != blank -%}<span class="dot-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}<h2 class="mh2">{{ section.settings.heading }}</h2></div><div class="vsec-r">{%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}<div class="vsec-btns">{%- if section.settings.subscribe_label != blank -%}<a class="vsec-sub" href="{{ section.settings.channel_url | escape }}?sub_confirmation=1" target="_blank" rel="noopener"><svg width="20" height="14" viewBox="0 0 28 20" aria-hidden="true"><path fill="#FF0033" d="M27.4 3.1A3.5 3.5 0 0 0 24.9.6C22.7 0 14 0 14 0S5.3 0 3.1.6A3.5 3.5 0 0 0 .6 3.1C0 5.3 0 10 0 10s0 4.7.6 6.9a3.5 3.5 0 0 0 2.5 2.5C5.3 20 14 20 14 20s8.7 0 10.9-.6a3.5 3.5 0 0 0 2.5-2.5C28 14.7 28 10 28 10s0-4.7-.6-6.9Z"></path><path fill="#fff" d="M11.2 14.3 18.5 10l-7.3-4.3z"></path></svg>{{ section.settings.subscribe_label }}</a>{%- endif -%}{%- if section.settings.all_label != blank -%}<a class="vsec-ch" href="{{ section.settings.channel_url | escape }}/videos" target="_blank" rel="noopener">{{ section.settings.all_label }}</a>{%- endif -%}</div></div></div>
<div class="vfx">{%- assign rest = '' -%}{%- for block in section.blocks -%}{%- assign v = block.settings.video -%}{%- if v and v.id != blank -%}
{%- capture fb -%}{% if block.settings.image %}|{{ block.settings.image | image_url: width: 640 }}{% endif %}{%- endcapture -%}
{%- if forloop.first -%}<a class="vfx-main" href="https://www.youtube.com/watch?v={{ v.id }}" target="_blank" rel="noopener" aria-label="{{ 'grs.a11y.watch' | t: title: block.settings.title, duration: block.settings.duration }}" {{ block.shopify_attributes }}><span class="vfx-media"><img class="ph yt-th" src="https://i.ytimg.com/vi/{{ v.id }}/maxresdefault.jpg" data-fb="https://i.ytimg.com/vi/{{ v.id }}/sddefault.jpg|https://i.ytimg.com/vi/{{ v.id }}/hqdefault.jpg{{ fb }}" alt="" loading="lazy" decoding="async"><span class="vfx-pill"><span class="vfx-pi"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"></path></svg></span><span>{{ t_watch_label }}</span>{%- if block.settings.duration != blank -%}<span class="vfx-pd">{{ block.settings.duration }}</span>{%- endif -%}</span></span><span class="vfx-body">{%- if block.settings.label != blank -%}<span class="vfx-k">{{ block.settings.label }}</span>{%- endif -%}<span class="vfx-t">{{ block.settings.title | escape }}</span><span class="vfx-link">{{ t_link_label }} <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg></span></span></a>
{%- else -%}{%- capture row -%}<li {{ block.shopify_attributes }}><a class="vfx-row" href="https://www.youtube.com/watch?v={{ v.id }}" target="_blank" rel="noopener" aria-label="{{ 'grs.a11y.watch' | t: title: block.settings.title, duration: block.settings.duration }}"><span class="vfx-th"><img class="ph yt-th" src="https://i.ytimg.com/vi/{{ v.id }}/sddefault.jpg" data-fb="https://i.ytimg.com/vi/{{ v.id }}/hqdefault.jpg{{ fb }}" alt="" loading="lazy" decoding="async"><span class="vfx-mini"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"></path></svg></span>{%- if block.settings.duration != blank -%}<span class="vfx-d">{{ block.settings.duration }}</span>{%- endif -%}</span><span class="vfx-rb">{%- if block.settings.label != blank -%}<span class="vfx-k">{{ block.settings.label }}</span>{%- endif -%}<span class="vfx-rt">{{ block.settings.title | escape }}</span><span class="vfx-link">{{ t_link_label }} <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg></span></span></a></li>{%- endcapture -%}{%- assign rest = rest | append: row -%}{%- endif -%}
{%- endif -%}{%- endfor -%}{%- if rest != '' -%}<ul class="vfx-list" role="list">{{ rest }}</ul>{%- endif -%}</div></div></section>

{% schema %}
{"name":"GRS installation videos","tag":"div","settings":[{"type":"text","id":"eyebrow","label":"Small title"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Text"},{"type":"url","id":"channel_url","label":"YouTube channel link"},{"type":"text","id":"subscribe_label","label":"Subscribe button label"},{"type":"text","id":"all_label","label":"\"All videos\" label"},{"type":"text","id":"watch_label","label":"Label on the large video","placeholder":"Watch","info":"Empty: the standard text, in the visitor's language."},{"type":"text","id":"link_label","label":"Link text under each video","placeholder":"Watch on YouTube","info":"Empty: the standard text, in the visitor's language."},{"type":"header","content":"Layout and sizes","info":"100% keeps the original design."},{"type":"range","id":"content_width","label":"Content width","min":800,"max":1800,"step":20,"default":1440,"unit":"px"},{"type":"range","id":"space_top","label":"Space above","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"range","id":"space_bottom","label":"Space below","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"header","content":"Text sizes and style","info":"Sizes are set separately for computers and phones. 100% keeps the original design."},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"eyebrow_size","label":"Small title size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"eyebrow_size_mobile","label":"Small title size (phone)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size","label":"Heading size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size_mobile","label":"Heading size (phone)"},{"type":"select","id":"heading_weight","label":"Heading weight","default":"default","options":[{"value":"default","label":"As designed"},{"value":"300","label":"Light"},{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}]},{"type":"select","id":"heading_case","label":"Heading letters","default":"default","options":[{"value":"default","label":"As written"},{"value":"uppercase","label":"ALL CAPITALS"}]},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"title_size","label":"Video title size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"title_size_mobile","label":"Video title size (phone)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size","label":"Text size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size_mobile","label":"Text size (phone)"}],"blocks":[{"type":"video","name":"Video","settings":[{"type":"video_url","id":"video","label":"YouTube video link","accept":["youtube"]},{"type":"text","id":"label","label":"Small label"},{"type":"text","id":"title","label":"Title"},{"type":"text","id":"duration","label":"Length (for example 1:55)"},{"type":"image_picker","id":"image","label":"Backup cover photo","info":"Shown only if YouTube has no cover for the video."}]}],"max_blocks":8,"presets":[{"name":"GRS installation videos"}]}
{% endschema %}