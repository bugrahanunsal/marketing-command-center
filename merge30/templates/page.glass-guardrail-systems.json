    "faq": {
      "type": "grs-pg-faq",
      "settings": {
        "heading": "Glass Guardrail System FAQs"
      },
      "blocks": {
        "faq_E4mGCB": {
          "type": "question",
          "settings": {
            "question": "What building codes do glass guardrail systems need to meet?",
            "answer": "<p>Glass guardrail systems must comply with the National Building Code of Canada (NBCC) and all applicable provincial or municipal building codes. They must also meet requirements for guard height, structural loads, and the use of approved safety glass.</p>"
          }
        },
        "faq_fBKAcR": {
          "type": "question",
          "settings": {
            "question": "How are frameless glass guardrails attached?",
            "answer": "<p>Frameless glass guardrails are typically secured using base shoe channels, glass spigots, or side-mounted brackets. These mounting systems provide excellent strength while maintaining a clean, modern appearance with minimal visible hardware.</p>"
          }
        },
        "faq_rVrymQ": {
          "type": "question",
          "settings": {
            "question": "What is the difference between a guardrail and a handrail?",
            "answer": "<p>A guardrail is designed to prevent falls from elevated surfaces such as decks, balconies, and stair landings. A handrail provides support and stability when using stairs or ramps, and both may be required depending on the application and local building codes.</p>"
          }
        },
        "faq_WLCTJk": {
          "type": "question",
          "settings": {
            "question": "Can glass guardrails withstand high winds?",
            "answer": "<p>Yes. Properly engineered glass guardrails are designed to withstand high wind loads when installed according to Canadian building codes. Tempered or laminated safety glass and heavy-duty hardware ensure long-term structural performance.</p>"
          }
        },
        "faq_VPce4K": {
          "type": "question",
          "settings": {
            "question": "Are glass guardrails safe for commercial buildings?",
            "answer": "<p>Yes. Glass guardrails are widely used in commercial buildings, including offices, hotels, shopping centres, and public spaces. When designed and installed to code, they provide a safe, durable, and low-maintenance railing solution.</p>"
          }
        },
        "faq_TKKG43": {
          "type": "question",
          "settings": {
            "question": "How thick should guardrail glass be?",
            "answer": "<p>Most glass guardrail systems use 10 mm to 12 mm tempered glass, while some commercial or structural applications require laminated tempered glass for additional strength. The required thickness depends on the system design, building code, and project specifications.</p>"
          }
        },
        "faq_3DVwjA": {
          "type": "question",
          "settings": {
            "question": "Do you provide engineering for guardrail systems?",
            "answer": "<p>Yes. We can provide engineered glass guardrail solutions, including stamped drawings and structural calculations when required for residential and commercial projects. Our team ensures every system meets applicable building codes and engineering standards.</p>"
          }
        },
        "faq_JUQPkN": {
          "type": "question",
          "settings": {
            "question": "Can I install a glass guardrail system myself?",
            "answer": "<p>Yes. Many glass guardrail systems are available as DIY kits with pre-engineered components and installation instructions. However, larger or commercial projects should be installed by experienced professionals to ensure safety and code compliance.</p>"
          }
        }
      },
