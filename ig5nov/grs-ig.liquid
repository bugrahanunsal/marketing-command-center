{"name":"GRS Instagram","tag":"div","settings":[{"type":"text","id":"eyebrow","label":"Small title","default":"Instagram"},{"type":"text","id":"heading","label":"Heading (computer)","default":"Follow our projects on Instagram","info":"Shown next to the phone picture on computers."},{"type":"text","id":"handle","label":"Account name","default":"@glassrailingstore","info":"The heading on phones and tablets, and the top line of the phone picture."},{"type":"textarea","id":"text","label":"Text (phones and tablets)","default":"Real decks, stairs and balconies from our customers, and new products as they land."},{"type":"text","id":"bullet_1","label":"Point 1 (computer)","default":"Real decks, stairs and balconies from our customers"},{"type":"text","id":"bullet_2","label":"Point 2 (computer)","default":"New products as they land"},{"type":"text","id":"bullet_3","label":"Point 3 (computer)","default":"Brushed stainless and matte black, in real light"},{"type":"url","id":"profile_url","label":"Instagram profile link"},{"type":"header","content":"Buttons"},{"type":"text","id":"button_label","label":"Main button (phones and tablets)","default":"Follow on Instagram"},{"type":"text","id":"profile_label","label":"Second button (phones and tablets)","default":"View profile","info":"Leave empty to show only the main button."},{"type":"text","id":"open_label","label":"Button (computer)","default":"Open Instagram"},{"type":"header","content":"Phone picture (computer)"},{"type":"image_picker","id":"avatar","label":"Profile picture","info":"Shown in a round frame, also on phones and tablets. A logo on a white or transparent background works best."},{"type":"text","id":"name","label":"Name","default":"The Glass Railing Store"},{"type":"text","id":"phone_text","label":"Short text","default":"Real decks, stairs and balconies from our customers."},{"type":"text","id":"follow_label","label":"Follow button","default":"Follow"},{"type":"text","id":"more_label","label":"Link under the posts"