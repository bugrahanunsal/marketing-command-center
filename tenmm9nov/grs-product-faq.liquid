{%- comment -%}
  Product FAQ (prototype #pfaqsec, same look as the home FAQ without the photo). Each question shows on the products
  picked in its "Show on these products" setting, or on every product when that is empty, but never on the products
  picked in its "Hide on these products" setting (custom glass, owner 9 Nov 2026). An optional U.S. answer
  replaces the answer in the U.S. market.
  Speed: which questions show is worked out once (shown_q, block positions) and reused for the structured data.
{%- endcomment -%}
{%- liquid
  assign grs_us = false
  if localization.market.handle == 'us' or localization.country.iso_code == 'US'
    assign grs_us = true
  endif
  assign n = 0
  assign shown_q = '|'
-%}
{%- capture items -%}{%- for block in section.blocks -%}{%- liquid
    assign show = true
    if block.settings.products.size > 0
      assign show = false
      for x in block.settings.products
        if x.handle == product.handle
          assign show = true
          break
        endif
      endfor
    endif
    if show
      for x in block.settings.hide_products
        if x.handle == product.handle
          assign show = false
          break
        endif
      endfor
    endif
    assign ans = block.settings.answer
    if grs_us and block.settings.answer_us != blank
      assign ans = block.settings.answer_us
    endif
  -%}{%- if show -%}{%- assign n = n | plus: 1 -%}{%- assign shown_q = shown_q | append: forloop.index0 | append: '|' -%}<div class="acc{% if block.settings.open %} open{% endif %}" {{ block.shopify_attributes }}><h3 class="acc-h"><button type="button" class="acc-q" aria-expanded="{% if block.settings.open %}true{% else %}false{% endif %}"><span>{{ block.settings.question }}</span><span class="pm" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M1 7h12"></path><path class="v" d="M7 1v12"></path></svg></span></button></h3><div class="acc-a"><div>{% render 'grs-rte', html: ans %}</div></div></div>{%- endif -%}{%- endfor -%}{%- endcapture -%}
{%- if n > 0 -%}
<section class="sec faqsec" id="pfaqsec"{% render 'grs-vars', s: section.settings %}><div class="wrap faq2"><div class="faq2-l">{%- if section.settings.eyebrow != blank -%}<span class="dot-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}<h2 class="mh2">{{ section.settings.heading }}</h2>{%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}<div class="faq2-btns">{%- if section.settings.button_label != blank -%}<a class="btn " href="{% render 'grs-url', url: section.settings.button_link %}"><span class="dot"></span>{{ section.settings.button_label }}</a>{%- endif -%}{%- if section.settings.button2_label != blank -%}<a class="btn btn-o" href="{% render 'grs-url', url: section.settings.button2_link %}"><span class="dot"></span>{{ section.settings.button2_label }}</a>{%- endif -%}</div></div><div id="pfaq"><div class="list">{{ items }}</div></div></div></section>
{%- endif -%}
{%- if section.settings.faq_schema -%}
{%- liquid
  assign dq = ''
  if section.settings.desc_faq
    capture dq
      render 'grs-rte-faq', html: product.description
    endcapture
    assign dq = dq | strip
  endif
-%}
{%- if n > 0 or dq != '' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ dq }}
{%- if dq != '' %}{% assign sep = ',' %}{% else %}{% assign sep = '' %}{% endif -%}
{%- for block in section.blocks -%}{%- liquid
    assign show = false
    assign qk = '|' | append: forloop.index0 | append: '|'
    if shown_q contains qk
      assign show = true
    endif
    assign ans = block.settings.answer
    if grs_us and block.settings.answer_us != blank
      assign ans = block.settings.answer_us
    endif
    if show and dq != ''
      assign qj = block.settings.question | json
      if dq contains qj
        assign show = false
      endif
    endif
  -%}{%- if show -%}{{ sep }}{"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ ans | strip_html | strip | json }}}}{%- assign sep = ',' -%}{%- endif -%}{%- endfor -%}
]}</script>
{%- endif -%}
{%- endif -%}

{% schema %}
{"name":"GRS product FAQ","tag":"div","settings":[{"type":"paragraph","content":"Each question shows on the products picked in it, or on every product when none are picked. Products picked in \"Hide on these products\" never show it."},{"type":"text","id":"eyebrow","label":"Small title"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Text"},{"type":"text","id":"button_label","label":"First button label"},{"type":"url","id":"button_link","label":"First button link"},{"type":"text","id":"button2_label","label":"Second button label"},{"type":"url","id":"button2_link","label":"Second button link"},{"type":"checkbox","id":"faq_schema","label":"Add the questions to the page's structured data (FAQ)","default":true},{"type":"checkbox","id":"desc_faq","label":"Also add the FAQ written in the product description","default":true,"info":"Questions under a \"FAQs\" heading in the description. They show there as an accordion."},{"type":"header","content":"Layout and sizes","info":"100% keeps the original design."},{"type":"range","id":"content_width","label":"Content width","min":800,"max":1800,"step":20,"default":1440,"unit":"px"},{"type":"range","id":"space_top","label":"Space above","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"range","id":"space_bottom","label":"Space below","min":0,"max":200,"step":5,"default":100,"unit":"%"},{"type":"header","content":"Text sizes and style","info":"Sizes are set separately for computers and phones. 100% keeps the original design."},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"eyebrow_size","label":"Small title size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"eyebrow_size_mobile","label":"Small title size (phone)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size","label":"Heading size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"heading_size_mobile","label":"Heading size (phone)"},{"type":"select","id":"heading_weight","label":"Heading weight","default":"default","options":[{"value":"default","label":"As designed"},{"value":"300","label":"Light"},{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}]},{"type":"select","id":"heading_case","label":"Heading letters","default":"default","options":[{"value":"default","label":"As written"},{"value":"uppercase","label":"ALL CAPITALS"}]},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"title_size","label":"Question size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"title_size_mobile","label":"Question size (phone)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size","label":"Text size (computer)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_size_mobile","label":"Text size (phone)"},{"min":50,"max":200,"step":5,"unit":"%","default":100,"type":"range","id":"text_width","label":"Text width"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question"},{"type":"richtext","id":"answer","label":"Answer"},{"type":"richtext","id":"answer_us","label":"Answer in the U.S. (optional)"},{"type":"product_list","id":"products","label":"Show on these products","limit":50,"info":"Leave empty to show on every product."},{"type":"product_list","id":"hide_products","label":"Hide on these products","limit":50,"info":"For example a general answer that does not fit the custom glass."},{"type":"checkbox","id":"open","label":"Open at start","default":false}]}],"max_blocks":50}
{% endschema %}